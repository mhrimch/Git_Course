import { useMcdPalette } from '@finanzinformatik/mcd-module-theme-provider';
import { Button, Chip, Skeleton, Typography, useMediaQuery, useTheme } from '@mui/material';
import { Stack } from '@mui/system';
import { ThemeConstants, useNotificationStoreActions } from '@personalsysteme/core';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { useEffect, useMemo, useState } from 'react';
import { I18nextProvider, useTranslation } from 'react-i18next';
import { ArbeitsortMenu } from './components/ArbeitsortMenu';
import { useCreateBuchung } from './hooks/useCreateBuchung';
import { useReadBenutzerStatus } from './hooks/useReadBenutzerStatus';
import { useReadKonfArbeitsorte } from './hooks/useReadKonfArbeitsorte';
import i18n, { ZEITWIRTSCHAFT_BUCHEN_NAMESPACE } from './i18n';
import { TanstackConstants } from './TanstackConstants';

export const Arbeitsorte = {
  buero: 'Im Büro',
  mobileArbeit: 'Mobile Arbeit',
} as const;

export type Arbeitsort = (typeof Arbeitsorte)[keyof typeof Arbeitsorte];

export const BuchungAnlegenConstants: Record<Arbeitsort, number> = {
  [Arbeitsorte.buero]: 11200,
  [Arbeitsorte.mobileArbeit]: 11201,
};

// QueryClient Setup (oder global aus Context nutzen)
const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      retry: false,
      gcTime: TanstackConstants.STD_GC_TIME,
      staleTime: TanstackConstants.STD_STALE_TIME,
      refetchOnWindowFocus: false,
    },
    mutations: { retry: false },
  },
});

export const ZeitwirtschaftBuchen = () => {
  const { t } = useTranslation(ZEITWIRTSCHAFT_BUCHEN_NAMESPACE);
  const { ColorTokens } = useMcdPalette();
  const theme = useTheme();
  const isDesktop = useMediaQuery(theme.breakpoints.up('sm'));

  const CHIP_MIN_WIDTH = 64;
  const CHIP_HEIGHT = 32;
  const BUTTON_BUCHEN_MIN_WIDTH = '119px';

  // State
  const [selectedArbeitsort, setSelectedArbeitsort] = useState<Arbeitsort>(Arbeitsorte.buero);

  // Custom Hooks
  const { mutate: createBuchung } = useCreateBuchung();
  const { data: benutzerStatus, isLoading: isStatusLoading } = useReadBenutzerStatus();
  console.log('benutzerStatus', benutzerStatus);
  const { data: konfigBenutzer } = useReadKonfArbeitsorte();
  console.log('konfigBenutzer', konfigBenutzer);

  const notificationStoreActions = useNotificationStoreActions();

  // Konfiguration State
  const [visibleArbeitsorte, setVisibleArbeitsorte] = useState({
    isBuero: true,
    isMobileArbeit: false,
  });

  useEffect(() => {
    if (benutzerStatus?.aktiverArbeitsort) {
      setSelectedArbeitsort(benutzerStatus.aktiverArbeitsort);
    }
  }, [benutzerStatus]);

  useEffect(() => {
    if (konfigBenutzer) {
      setVisibleArbeitsorte(konfigBenutzer);
    }
  }, [konfigBenutzer]);

  /**
   * Berechnet Label und Farbe für den Chip.
   */
  const chipData = useMemo(() => {
    // 1. Fall: Inaktiv
    if (!benutzerStatus?.aktiv) {
      return {
        label: t('BuchenStatusInaktiv'),
        color: ColorTokens[ThemeConstants.COLOR_TOKEN_INFORMATION_01], // Grau/Blau
      };
    }

    // 2. Fall: Aktiv
    const labelMap: Record<string, string> = {
      [Arbeitsorte.buero]: t('AktivImBuero'),
      [Arbeitsorte.mobileArbeit]: t('AktivMobileArbeit'),
    };

    // Text ermitteln (mit Fallback)
    const statusText = benutzerStatus.aktiverArbeitsort
      ? labelMap[benutzerStatus.aktiverArbeitsort]
      : t('BuchenStatusAktiv');
    return {
      label: `${statusText} ${benutzerStatus.buchungBeginn}`,
      color: ColorTokens[ThemeConstants.COLOR_TOKEN_SUCCESS_01], // Grün
    };
  }, [benutzerStatus, t, ColorTokens]);

  const handleBuchung = () => {
    // Der Hook kümmert sich um den Toggle-Status (Optimistic Update).

    const buchungEigsNr = BuchungAnlegenConstants[selectedArbeitsort];
    createBuchung({ buchungEigsNr: buchungEigsNr });
  };
  const mobileStylesStickiness = {
    ...(!isDesktop && {
      position: 'fixed',
      bottom: 0,
      left: 0,
      right: 0,
      padding: 5,
      zIndex: 3,
      backgroundColor: ColorTokens[ThemeConstants.COLOR_TOKEN_UI_BACKGROUND_01],
    }),
  };

  return (
    <QueryClientProvider client={queryClient}>
      <I18nextProvider i18n={i18n}>
        <Stack
          direction="row"
          display="flex"
          width={ThemeConstants.WIDTH_100_PERCENT}
          spacing={ThemeConstants.GRID_CONTAINER_SPACING}
          alignItems={ThemeConstants.ALIGNMENT_CENTER}
          justifyContent={isDesktop ? ThemeConstants.CONTENT_ALIGN_FLEX_END : ThemeConstants.ALIGNMENT_CENTER}
          sx={mobileStylesStickiness}
        >
          {isStatusLoading ? (
            <Skeleton
              variant={ThemeConstants.VARIANT_ROUNDED}
              animation={ThemeConstants.ANIMATION_PULSE}
              width={CHIP_MIN_WIDTH}
              height={CHIP_HEIGHT}
            />
          ) : (
            <Chip
              label={
                <Typography variant={ThemeConstants.TYPOGRAPHY_HEADLINE_06} color={chipData.color}>
                  {chipData.label}
                </Typography>
              }
              color={benutzerStatus?.aktiv ? ThemeConstants.SUCCESS : ThemeConstants.INFO}
              sx={{ minWidth: CHIP_MIN_WIDTH, height: CHIP_HEIGHT }}
            />
          )}

          <Button
            variant={ThemeConstants.BUTTON_VARIANT_CONTAINED}
            size={ThemeConstants.LARGE}
            onClick={handleBuchung}
            sx={{ minWidth: BUTTON_BUCHEN_MIN_WIDTH }}
          >
            {t('BuchenButtonLabel')}
          </Button>

          <ArbeitsortMenu
            isMobileArbeit={visibleArbeitsorte.isMobileArbeit}
            selectedArbeitsort={selectedArbeitsort}
            setSelectedArbeitsort={setSelectedArbeitsort}
          />
        </Stack>
      </I18nextProvider>
    </QueryClientProvider>
  );
};
