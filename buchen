interface ArbeitsortMenuProps {
  isMobileArbeit: boolean;
  selectedArbeitsort: Arbeitsort;
  setSelectedArbeitsort: Dispatch<SetStateAction<Arbeitsort>>;
}

export const ArbeitsortMenu = ({ isMobileArbeit, selectedArbeitsort, setSelectedArbeitsort }: ArbeitsortMenuProps) => {
  const { ColorTokens } = useMcdPalette();
  const [anchorEl, setAnchorEl] = useState<HTMLElement | null>(null);
  const open = Boolean(anchorEl);

  const handleClick = (event: MouseEvent<HTMLButtonElement>) => {
    console.log('clicked...', event.target);

    setAnchorEl(event.currentTarget);
  };
  const handleClose = (arbeitsort?: Arbeitsort) => {
    if (arbeitsort) {
      setSelectedArbeitsort(arbeitsort);
    }
    setAnchorEl(null);
  };

  if (!isMobileArbeit) {
    return (
      <Button size={ThemeConstants.LARGE} startIcon={<IcCompanyS />}>
        {selectedArbeitsort}
      </Button>
    );
  }

  return (
    <>
      <Button
        size={ThemeConstants.LARGE}
        startIcon={selectedArbeitsort === Arbeitsorte.mobileArbeit ? <IcHouseS /> : <IcCompanyS />}
        endIcon={<IcDownS />}
        onClick={handleClick}
      >
        {selectedArbeitsort}
      </Button>
      <Menu anchorEl={anchorEl} open={open} onClose={() => handleClose()} disableScrollLock={true}>
        <MenuItem
          value={Arbeitsorte.buero}
          key={Arbeitsorte.buero}
          selected={selectedArbeitsort === Arbeitsorte.buero}
          onClick={() => handleClose(Arbeitsorte.buero)}
        >
          <ListItemIcon>
            {/*<SvgIcCompanyS sx={{ color: ColorTokens[ThemeConstants.COLOR_TOKEN_READABLE_02] }} />*/}
          </ListItemIcon>
          <ListItemText>{Arbeitsorte.buero}</ListItemText>
        </MenuItem>
        <MenuItem
          value={Arbeitsorte.mobileArbeit}
          key={Arbeitsorte.mobileArbeit}
          selected={selectedArbeitsort === Arbeitsorte.mobileArbeit}
          onClick={() => handleClose(Arbeitsorte.mobileArbeit)}
        >
          <ListItemIcon>
            {/*<SvgIcHouseS sx={{ color: ColorTokens[ThemeConstants.COLOR_TOKEN_READABLE_02] }} />*/}
          </ListItemIcon>
          <ListItemText>{Arbeitsorte.mobileArbeit}</ListItemText>
        </MenuItem>
      </Menu>
    </>
  );
};

