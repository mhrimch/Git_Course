            addWarningNotification(t('Dokumente.Upload.MaxFiles', { filename: fileRejection.file.name }));
            return false;
          } else {
            addWarningNotification(t('Dokumente.Upload.Fehler', { filename: fileRejection.file.name }));
          }
        });
      });
