export default function AntragAbwesenheitAnzeigen({
  antragData: {
    antragBezeichnung,
    anfangTs,
    endeTs,
    iconId,
    mitarbeiterKommentar,
    fuehrungskraftKommentar,
    antragStatus,
    anzahlTage,
    antragSchluessel,
    isGanztaegig,
    einfuegungTimestamp,
    absVgngPrzId,
    isStornierung,
  },
  dokumente,
}: {
  antragData: AntraegeRow;
  dokumente?: DokumentRead[];
}) {
  return (
    <>
      <Stack gap={10}>
        <Typography variant="headline02">
          {isStornierung ? antragBezeichnung + ' - ' + t('Stornierung') : antragBezeichnung}
        </Typography>
        <Stack direction="row" justifyContent="space-around">
          <DatumCard timestamp={anfangTs} iconId={iconId} isGanztaegig={isGanztaegig} />
          <Stack direction="column" justifyContent="center">
            <AntragStatusChip antragStatus={antragStatus} />
            <Divider variant="fullWidth" style={{ margin: ThemeConstants.STACK_SPACING }} />
            {anzahlTage === 1 && <Chip label={<Typography variant="label04">1 {t('Tag')}</Typography>} />}
            {anzahlTage !== undefined && anzahlTage > 1 && (
              <Chip label={<Typography variant="label04">{`${anzahlTage} ${t('Tage')}`}</Typography>} />
            )}
          </Stack>
          <DatumCard timestamp={endeTs} iconId={iconId} isGanztaegig={isGanztaegig} />
        </Stack>
        {mitarbeiterKommentar && (
          <TextField disabled={true} fullWidth value={mitarbeiterKommentar} multiline={true} minRows={3} />
        )}
        {fuehrungskraftKommentar && (
          <>
            <Typography variant="multiline02Bold">{t('fuehrungskraftKommentar')}</Typography>
            <TextField disabled={true} fullWidth value={fuehrungskraftKommentar} multiline={true} minRows={3} />
          </>
        )}
        {dokumente && dokumente.length > 0 && <DokumentTabelle dokumente={dokumente} readOnly={true} />}
      </Stack>
      {!isStornierung && (
        <Stack direction="row" justifyContent="flex-end" sx={{ marginTop: ThemeConstants.STACK_SPACING }}>
          <AntragAbwesenheitStornierenModal
            antragSchluessel={antragSchluessel}
            anfangTs={anfangTs}
            endeTs={endeTs}
            isGanztaegig={isGanztaegig}
            absPrzId={absVgngPrzId}
            antragStatus={antragStatus}
            einfuegungTimestamp={einfuegungTimestamp}
            anzahlTage={anzahlTage}
          />
        </Stack>
      )}
    </>
  );
}

function DatumCard({
  timestamp,
  iconId,
  isGanztaegig,
}: {
  timestamp: IdTimestamp;
  iconId: number;
  isGanztaegig: boolean;
}) {
  const { backgroundColor, Icon, color } = getIconConfiguration(iconId);
  const timestampDayjs = idTimestampToDayjs(timestamp);
  return (
    <Stack alignItems="center" spacing={ThemeConstants.STACK_SPACING_HORIZONTAL}>
      <Avatar
        sx={{
          height: ThemeConstants.AVATAR_SIZE_72,
          width: ThemeConstants.AVATAR_SIZE_72,
          bgcolor: backgroundColor,
        }}
      >
        {<Icon sx={{ fill: color }} />}
      </Avatar>
      <Stack alignItems="center">
        <Typography variant="multiline02">
          {new Date(timestampDayjs.format(KalenderConstants.DATUM_ISO_FORMAT_STRING)).toLocaleDateString(
            PzwConstants.LOCALES_DE_DE,
            {
              weekday: 'long',
            }
          )}
        </Typography>
        <Typography variant="headline02">{timestampDayjs.format(KalenderConstants.DATUM_FORMAT_STRING)}</Typography>
        {!isGanztaegig && (
          <Typography variant="headline04">{timestampDayjs.format(KalenderConstants.DAY_JS_FORMAT_HH_MM)}</Typography>
        )}
      </Stack>
    </Stack>
  );
}
