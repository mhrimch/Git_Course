import { UuiServiceResponse } from '@finanzinformatik/cpl-module-clientlib';
import { useUuiService } from '@finanzinformatik/cpl-module-reactlib';
import { useMutation } from '@tanstack/react-query';
import { callDownloadFileByDownloadToken } from '../../apl/pzw/dokumenteUiModule/dokumenteUiModuleApi';
import { ExtendedUuiServiceMessage, useNotificationStoreActions } from '@personalsysteme/notification-handler';

export function useCreateDownloadLink() {
  const uuiService = useUuiService(),
    notificationStoreActions = useNotificationStoreActions();

  return useMutation({
    mutationFn: async (downloadToken: string) =>
      callDownloadFileByDownloadToken(uuiService, downloadToken)
        .then((response: UuiServiceResponse<string>) => {
          notificationStoreActions.handleMessages(response.messages as ExtendedUuiServiceMessage[], true);
          return response.payload;
        })
        .catch(notificationStoreActions.handleError),
  });
}
