export const DokumentUploadZone = ({ maxFiles, onSubmit }: DokumenteHochladenDialogProps) => {
  const { t } = useTranslation(),
    { addWarningNotification } = useNotificationStoreActions(),
    onDropAccepted = useCallback((files: File[]) => {
      onSubmit(files);
    }, []),
    onDropRejected = useCallback((fileRejections: FileRejection[]) => {
      fileRejections.forEach((fileRejection) => {
        fileRejection.errors.forEach((fileError) => {
          if (ErrorCode.FileInvalidType === fileError.code) {
            addWarningNotification(t('Dokumente.Upload.InvalidFile', { filename: fileRejection.file.name }));
          } else if (ErrorCode.FileTooLarge === fileError.code) {
            addWarningNotification(t('Dokumente.Upload.FileToLarge', { filename: fileRejection.file.name }));
