import { FormControl, FormHelperText } from '@mui/material';
import { TimePicker } from '@mui/x-date-pickers';
import 'dayjs/locale/de';
import dayjs, { Dayjs } from 'dayjs';
import { Controller, useFormContext } from 'react-hook-form';

export const FormInputTimePicker = ({ name, label, required }: { name: string; label: string; required: boolean }) => {
  const { control: contextControl } = useFormContext();
  return (
    <FormControl fullWidth={true}>
      <Controller
        rules={{ required: required }}
        name={name}
        control={contextControl}
        render={({ field: { ref, ...field }, fieldState: { error } }) => (
          <>
            <TimePicker
              {...field}
              value={dayjs(field.value as Dayjs)}
              defaultValue={dayjs().hour(0).minute(0)}
              onChange={(value: Dayjs | null) => {
                field.onChange(value);
              }}
              inputRef={ref}
              ampm={false}
              slotProps={{ textField: { required: required, error: Boolean(error) } }}
              label={label}
            />
            <FormHelperText error>{error?.message}</FormHelperText>
          </>
        )}
      />
    </FormControl>
  );
};
