import dayjs, { Dayjs } from 'dayjs';
import { useTranslation } from 'react-i18next';
import z from 'zod';
import { KalenderConstants } from '../../constants/KalenderConstants';
import { validateUhrzeitEingabe } from './BuchungKorrigieren';

export const getFormSchemaTagesbuchung = (isKommentarPflicht?: boolean) => {
  const { t } = useTranslation();
  return z
    .object({
      datum: z
        .string()
        .nonempty({
          message: t('Pflichtfeld'),
        })
        .refine((val) => dayjs(val).isSameOrBefore(dayjs(), KalenderConstants.TAG), {
          message: t('ZeitkorrekturDatumNichtInZukunft'),
        }),
      zeitkorrekturbuchungen: z
        .object({
          buchungsart: z.number(),
          zeitpunkt: z.custom<Dayjs>((val) => dayjs.isDayjs(val) && dayjs(val).isValid(), {
            message: t('Pflichtfeld'),
          }),
        })
        .array(),
      kommentar: isKommentarPflicht ? z.string().min(1, t('Pflichtfeld')) : z.string(),
    })
    .superRefine((values, context) =>
      values.zeitkorrekturbuchungen.forEach((buchung, index) => {
        if (!validateUhrzeitEingabe(dayjs(buchung.zeitpunkt), dayjs(values.datum))) {
          context.addIssue({
            code: 'custom',
            path: [`zeitkorrekturbuchungen.${index}.zeitpunkt`],
            message: t('ZeitkorrekturUngueltigeUhrzeit'),
          });
        }
      })
    );
};
