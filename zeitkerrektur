import { IcPlusS } from '@finanzinformatik/mcd-module-icons';
import { Alert, Box, Button, FormControl, Stack } from '@mui/material';
import { LocalizationProvider } from '@mui/x-date-pickers';
import { AdapterDayjs } from '@mui/x-date-pickers/AdapterDayjs';
import { FormInputTextField, FormInputTimePicker, ThemeConstants } from '@personalsysteme/core';
import dayjs, { Dayjs } from 'dayjs';
import { Dispatch, SetStateAction } from 'react';
import { useFieldArray, useFormContext } from 'react-hook-form';
import { useTranslation } from 'react-i18next';
import { KonfAntragRead } from '../../apl/pzw/konfigUiModule/KonfAntragRead';
import { KalenderConstants } from '../../constants/KalenderConstants';
import { BuchungsEigsNummern } from '../../constants/PzwConstants';
import { useReadKonfArbeitsorte } from '../../tanstack/konfiguration/useReadKonfArbeitsorte';
import { ControlledSelectArbeitsort } from './ControlledSelectArbeitsort';

interface BuchungKorrigierenProps {
  absVgngPrzId?: string;
  weiterleitung?: () => void;
  konfAntragZeitkorrektur: KonfAntragRead;
  bearbeiten?: boolean;
  setBearbeiten: Dispatch<SetStateAction<boolean>>;
  isPending: boolean;
}

export interface ZeitkorrekturInput {
  buchungsart: number;
  zeitpunkt: dayjs.Dayjs;
}

export const validateUhrzeitEingabe = (eingabe: Dayjs, korrekturdatum: Dayjs) => {
  if (korrekturdatum.isBefore(dayjs(), KalenderConstants.TAG)) {
    return true;
  }
  return eingabe.isBefore(dayjs(), KalenderConstants.MINUTE);
};

export const setBuchungszeitpunktToMeldungsdatum = ({
  buchung,
  datum,
}: {
  buchung: ZeitkorrekturInput;
  datum: string;
}) => {
  return {
    buchungsartEigsNr: buchung.buchungsart,
    zeitpunkt: buchung.zeitpunkt
      .set(KalenderConstants.JAHR, dayjs(datum).year())
      .set(KalenderConstants.MONAT, dayjs(datum).month())
      .set(KalenderConstants.DATUM, dayjs(datum).date())
      .format(KalenderConstants.DATUM_FORMAT_IDTIMESTAMP),
  };
};

export const BuchungKorrigieren = ({ konfAntragZeitkorrektur, setBearbeiten, isPending }: BuchungKorrigierenProps) => {
  const { t } = useTranslation();
  const { data: konfEinstellung } = useReadKonfArbeitsorte();
  const { control } = useFormContext();
  console.log('control', control);
  const { fields, append } = useFieldArray({
    name: 'zeitkorrekturbuchungen',
    control,
  });
  if (!konfEinstellung) {
    return;
  }
  return (
    <Box width={ThemeConstants.WIDTH_100_PERCENT}>
      <Stack spacing={ThemeConstants.STACK_SPACING}>
        {fields.map((field, index) => {
          return (
            <Stack
              key={field.id}
              direction="row"
              spacing={ThemeConstants.STACK_SPACING}
              width={ThemeConstants.WIDTH_100_PERCENT}
            >
              <FormControl fullWidth>
                <ControlledSelectArbeitsort
                  name={`zeitkorrekturbuchungen.${index}.buchungsart`}
                  label={t('Arbeitsort')}
                  required={true}
                  disabled={!konfEinstellung.isMobileArbeit}
                  isBuero={konfEinstellung.isBuero}
                  isMobileArbeit={konfEinstellung.isMobileArbeit}
                  control={control}
                />
              </FormControl>
              <LocalizationProvider dateAdapter={AdapterDayjs}>
                <FormControl fullWidth>
                  <FormInputTimePicker
                    name={`zeitkorrekturbuchungen.${index}.zeitpunkt`}
                    label={t('BuchungTabelle.Uhrzeit')}
                    required={true}
                  />
                </FormControl>
              </LocalizationProvider>
            </Stack>
          );
        })}
        <Box>
          <Button
            variant="text"
            startIcon={<IcPlusS />}
            onClick={() =>
              append({
                buchungsart: BuchungsEigsNummern.buero,
                zeitpunkt: dayjs(''),
              })
            }
          >
            {t('weitereBuchungenHinzufuegen')}
          </Button>
        </Box>
        <FormInputTextField
          name={'kommentar'}
          label={t('Kommentar')}
          required={konfAntragZeitkorrektur.isKommentarPflicht}
          multiline
          minRows={3}
        />
        <Alert severity="info" variant={'filled'} color={'info'}>
          {t('interneAktualisierungszyklen')}
        </Alert>

        <Stack
          direction={'row'}
          justifyContent={ThemeConstants.CONTENT_ALIGN_FLEX_END}
          spacing={ThemeConstants.GRID_CONTAINER_SPACING}
        >
          <Button
            variant={ThemeConstants.BUTTON_VARIANT_OUTLINED}
            onClick={() => setBearbeiten(false)}
            disabled={isPending}
          >
            {t('Abbrechen')}
          </Button>
          <Button variant={ThemeConstants.BUTTON_VARIANT_CONTAINED} type={'submit'} loading={isPending}>
            {t('Tagesbuchungen.Absenden')}
          </Button>
        </Stack>
      </Stack>
    </Box>
  );
};
