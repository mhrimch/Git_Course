import { DynamicTypography, useWorkflowService, UuiServiceMessageType } from '@finanzinformatik/cpl-module-reactlib';
import { zodResolver } from '@hookform/resolvers/zod';
import { Alert, Button, Checkbox, FormControlLabel } from '@mui/material';
import { Box, Stack } from '@mui/system';
import {
  addNotification,
  FormInputDatePicker,
  FormProviderWrapper,
  LocalDate,
  ThemeConstants,
} from '@personalsysteme/core';
import { useQueryClient } from '@tanstack/react-query';
import dayjs from 'dayjs';
import { parseAsString, useQueryState } from 'nuqs';
import { useEffect, useState } from 'react';
import { useForm } from 'react-hook-form';
import { useTranslation } from 'react-i18next';
import z from 'zod';
import { ZeitkorrekturWrite } from '../../apl/pzw/zeitkorrekturUiModule/ZeitkorrekturWrite';
import { KalenderConstants } from '../../constants/KalenderConstants';
import { AbsParameter, BuchungsEigsNummern, getTagesbuchungKonfFuerMeldungsart } from '../../constants/PzwConstants';
import { AntragKeys } from '../../tanstack/antrag/Antrag.keys';
import { useReadKonfAntraege } from '../../tanstack/konfiguration/useReadKonfAntraege';
import { useCreateZeitkorrektur } from '../../tanstack/zeitkorrektur/useCreateZeitkorrektur';
import { useReadMeldung } from '../../tanstack/zeitkorrektur/useReadMeldung';
import { navigateToPskMeinBereich } from '../../utils/bookmarkUtil';
import { AntraegeAbwesenheitUebersicht } from '../antraege/abwesenheit/AntraegeAbwesenheitUebersicht';
import { getAntragskonfiguration } from '../antraege/AntragUtils';
import { AntragsgruppenIds, AntragskategorieIds, Antragsschluessel } from '../zeitwirtschaft/ZeitwirtschaftConstants';
import { BuchungGutschreiben } from './BuchungGutschreiben';
import { BuchungKorrigieren, setBuchungszeitpunktToMeldungsdatum } from './BuchungKorrigieren';
import { getFormSchemaTagesbuchung } from './formSchemaTagesbuchung';
import { TagesbuchungAntraege } from './TagesbuchungAntraege';
import { TagesbuchungBuchungspaare } from './TagesbuchungBuchungspaare';
import { TagesbuchungOffeneBuchungen } from './TagesbuchungOffeneBuchungen';

export const Tagesbuchung = () => {
  const { t } = useTranslation();
  const [absVgngPrzId] = useQueryState(AbsParameter.ABS_VORGANG_PRZ_ID.name, parseAsString.withDefault(''));
  const [personalnummer] = useQueryState('personalnummer', parseAsString.withDefault(''));
  const [datum] = useQueryState('datum', parseAsString.withDefault(''));
  const [meldungsart] = useQueryState('meldungsart', parseAsString.withDefault(''));
  const [meldungstyp] = useQueryState('meldungstyp', parseAsString.withDefault(''));
  const { data: meldungRead, isLoading: isMeldungLoading } = useReadMeldung(
    absVgngPrzId,
    datum as LocalDate,
    meldungstyp,
    meldungsart,
    personalnummer !== ''
  );
  const meldungsdatum = meldungRead?.meldungsdatum ?? datum;
  const [bearbeiten, setBearbeiten] = useState(!datum);
  const [abwesenheitMelden, setAbwesenheitMelden] = useState(false);
  const [gutschriftBeantragen, setGutschriftBeantragen] = useState(false);
  const { mutateAsync: createZeitkorrektur, isPending } = useCreateZeitkorrektur();
  const queryClient = useQueryClient();

  const workflowService = useWorkflowService();

  const { data: konfAntraege, isLoading: isKonfAntraegeLoading } = useReadKonfAntraege();
  const konfAntragZeitkorrektur = konfAntraege
    ? getAntragskonfiguration(
        konfAntraege,
        AntragskategorieIds.zeitkorrektur,
        AntragsgruppenIds.zeitkorrektur,
        Antragsschluessel.zeitkorrektur
      )
    : undefined;
  const konfAntragVerfallszeit = konfAntraege
    ? getAntragskonfiguration(
        konfAntraege,
        AntragskategorieIds.zeitgutschriftVerfallszeit,
        AntragsgruppenIds.zeitgutschriftVerfallszeit,
        Antragsschluessel.zeitgutschriftVerfallszeit
      )
    : undefined;
  const formSchemaTagesbuchung = getFormSchemaTagesbuchung(konfAntragZeitkorrektur?.isKommentarPflicht);

  type FormValuesTagesbuchung = z.infer<typeof formSchemaTagesbuchung>;
  const methods = useForm<FormValuesTagesbuchung>({
    resolver: zodResolver(formSchemaTagesbuchung),
    defaultValues: {
      datum: meldungsdatum,
      zeitkorrekturbuchungen: [
        {
          buchungsart: BuchungsEigsNummern.buero,
          zeitpunkt: dayjs(''),
        },
      ],
      kommentar: '',
    },
  });
  const { formState } = methods;
  useEffect(() => {
    if (methods.formState.isSubmitSuccessful) {
      methods.reset({
        datum: methods.getValues('datum'),
        zeitkorrekturbuchungen: [
          {
            buchungsart: BuchungsEigsNummern.buero,
            zeitpunkt: dayjs(''),
          },
        ],
        kommentar: '',
      });
    }
  }, [formState, methods.reset]);
  const handleClickAbwesenheitMelden = () => {
    setAbwesenheitMelden((prevState) => !prevState);
  };
  const handleClickGutschriftBeantragen = () => {
    setGutschriftBeantragen((prevState) => !prevState);
  };

  const handleClickBearbeiten = () => {
    if (!konfAntragZeitkorrektur?.isAktiv && !konfAntragVerfallszeit?.isAktiv) {
      addNotification(t('Info'), t('ZeitkorrekturInaktivMeldung'), UuiServiceMessageType.Info);
      return;
    }
    setBearbeiten(true);
  };
  const handleClickSpeichern = (formData: FormValuesTagesbuchung) => {
    const eingabeDatum = meldungsdatum ? meldungsdatum : formData.datum;
    if (!eingabeDatum) {
      return;
    }
    const zeitkorrekturWrite: ZeitkorrekturWrite = {
      zeitkorrekturbuchungen: formData.zeitkorrekturbuchungen.map((buchung) =>
        setBuchungszeitpunktToMeldungsdatum({
          buchung: buchung,
          datum: eingabeDatum,
        })
      ),
      kommentar: formData.kommentar,
      absVgngPrzId: absVgngPrzId ? absVgngPrzId : '',
    };
    createZeitkorrektur(zeitkorrekturWrite).then(async () =>
      queryClient.invalidateQueries({ queryKey: AntragKeys.all })
    );
    setBearbeiten(false);
  };

  const TagesbuchungUeberschrift = () => {
    if (dayjs(meldungsdatum).isValid()) {
      return (
        <DynamicTypography variant={ThemeConstants.TYPOGRAPHY_HEADLINE_02}>
          {'Tagesbuchungen' +
            ' - ' +
            dayjs(meldungsdatum).format(KalenderConstants.TAG_FORMAT_LONG_STRING) +
            ' ' +
            dayjs(meldungsdatum).format(KalenderConstants.DATUM_FORMAT_STRING)}
        </DynamicTypography>
      );
    }
    return <DynamicTypography variant={ThemeConstants.TYPOGRAPHY_HEADLINE_02}>{'Tagesbuchungen'}</DynamicTypography>;
  };
  const meldungKonfig = meldungRead?.meldungsart
    ? getTagesbuchungKonfFuerMeldungsart(meldungRead.meldungsart)
    : undefined;
  const isGutschriftBeantragenCheckboxVisible =
    !personalnummer && bearbeiten && meldungRead?.meldungsart && meldungKonfig?.isGutschriftVerfallszeit;
  const isAbwesenheitMeldenCheckboxVisible =
    !personalnummer && bearbeiten && meldungRead?.meldungsart && meldungKonfig?.isAbwesenheitNachtragen;
  const isBuchungGutschreibenAnzeigen = Boolean(bearbeiten && gutschriftBeantragen && konfAntragVerfallszeit?.isAktiv);
  const eingabedatum = methods.watch('datum');
  return (
    <Stack>
      <FormProviderWrapper
        methods={methods}
        formId={'korrekturbuchungen-hinzufuegen-form'}
        onSubmit={handleClickSpeichern}
      >
        <Stack spacing={ThemeConstants.STACK_SPACING}>
          <TagesbuchungUeberschrift />
          {meldungRead?.meldungstext && (
            <Alert severity={ThemeConstants.INFO} variant={'filled'} color={ThemeConstants.ATTENTION}>
              {meldungRead.meldungstext}
            </Alert>
          )}
          {!isMeldungLoading && !meldungsdatum && (
            <Box>
              <FormInputDatePicker<FormValuesTagesbuchung>
                name={'datum'}
                label={'Datum'}
                slotProps={{ textField: { required: true } }}
              />
            </Box>
          )}
          <Stack direction={ThemeConstants.DIRECTION_ROW} justifyContent={ThemeConstants.CONTENT_ALIGN_FLEX_END}>
            {isGutschriftBeantragenCheckboxVisible && (
              <FormControlLabel
                control={<Checkbox checked={gutschriftBeantragen} onChange={handleClickGutschriftBeantragen} />}
                label={t('Tagesbuchungen.GutschriftBeantragen')}
              />
            )}
            {isAbwesenheitMeldenCheckboxVisible && (
              <FormControlLabel
                control={<Checkbox checked={abwesenheitMelden} onChange={handleClickAbwesenheitMelden} />}
                label={t('Tagesbuchungen.AbwesenheitMelden')}
              />
            )}
          </Stack>
          <TagesbuchungBuchungspaare
            meldungsdatum={meldungRead?.meldungsdatum}
            eingabedatum={eingabedatum as LocalDate}
            queryDatum={datum as LocalDate}
            personalnummer={personalnummer}
          />
          {bearbeiten && (
            <TagesbuchungOffeneBuchungen
              meldungsdatum={meldungRead?.meldungsdatum}
              eingabedatum={eingabedatum as LocalDate}
              queryDatum={datum as LocalDate}
              personalnummer={personalnummer}
            />
          )}
          {!isKonfAntraegeLoading && !personalnummer && !bearbeiten && (
            <Stack direction={ThemeConstants.DIRECTION_ROW} justifyContent={ThemeConstants.CONTENT_ALIGN_FLEX_END}>
              <Button variant={ThemeConstants.BUTTON_VARIANT_CONTAINED} onClick={handleClickBearbeiten}>
                {t('Bearbeiten')}
              </Button>
            </Stack>
          )}
          {bearbeiten && konfAntragZeitkorrektur?.isAktiv && !gutschriftBeantragen && (
            <BuchungKorrigieren
              weiterleitung={() => navigateToPskMeinBereich(workflowService)}
              konfAntragZeitkorrektur={konfAntragZeitkorrektur}
              bearbeiten={bearbeiten}
              setBearbeiten={setBearbeiten}
              isPending={isPending}
            />
          )}
        </Stack>
      </FormProviderWrapper>
      {isBuchungGutschreibenAnzeigen && (
        <BuchungGutschreiben
          meldungsdatum={meldungsdatum as LocalDate}
          setBearbeiten={setBearbeiten}
          isKommentarPflichtfeld={false}
        />
      )}
      {bearbeiten && (
        <TagesbuchungAntraege
          meldungsdatum={meldungRead?.meldungsdatum}
          eingabedatum={eingabedatum as LocalDate}
          queryDatum={datum as LocalDate}
          personalnummer={personalnummer}
        />
      )}
      {abwesenheitMelden && <AntraegeAbwesenheitUebersicht absVgngPrzId={absVgngPrzId} />}
    </Stack>
  );
};
