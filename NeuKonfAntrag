interface CheckboxRowProps {
  beschreibung: string;
  status: boolean;
  name: string;
  onChange: (event: ChangeEvent<HTMLInputElement>) => void;
  disabled: boolean;
  indent?: boolean;
}

const AntragseigenschaftCheckbox = ({ beschreibung, onChange, status, name, disabled, indent }: CheckboxRowProps) => {
  return (
    <TableRow>
      <TableCell padding="checkbox">
        <Stack direction={ThemeConstants.DIRECTION_ROW} alignItems={ThemeConstants.ALIGNMENT_CENTER} spacing={2}>
          <Checkbox
            checked={status}
            onChange={(e) => onChange(e)}
            name={name}
            disabled={disabled}
            sx={indent ? { pl: 6 } : undefined}
          />
          <Typography noWrap={true}>{beschreibung}</Typography>
        </Stack>
      </TableCell>
      <TableCell width={ThemeConstants.WIDTH_100_PERCENT} />
