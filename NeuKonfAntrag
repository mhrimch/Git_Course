import { KonfAntragRead } from '../../../apl/pzw/konfigUiModule/KonfAntragRead';

type OnUnsavedChanges = (antragId: string, hasChanges: boolean) => void;

export const pruefeAntragAufAenderung = (
  antrag: KonfAntragRead,
  updatedAntrag: KonfAntragRead,
  onUnsavedChanges?: OnUnsavedChanges | undefined
): boolean => {
  const hasChanges =
    antrag.isFuehrungskraftFreigabePflicht !== updatedAntrag.isFuehrungskraftFreigabePflicht ||
    antrag.isPersonalFreigabePflicht !== updatedAntrag.isPersonalFreigabePflicht ||
    antrag.isKommentarPflicht !== updatedAntrag.isKommentarPflicht ||
    antrag.isUhrzeit !== updatedAntrag.isUhrzeit ||
    antrag.isGanztaegig !== updatedAntrag.isGanztaegig ||
    antrag.isDocumentUploadPflicht !== updatedAntrag.isDocumentUploadPflicht ||
    antrag.isDocumentUpload !== updatedAntrag.isDocumentUpload ||
    antrag.epaArt !== updatedAntrag.epaArt ||
    antrag.anzahlTageRueckwirkenderKorrektur !== updatedAntrag.anzahlTageRueckwirkenderKorrektur ||
    antrag.url !== updatedAntrag.url;
  onUnsavedChanges?.(antrag.id, hasChanges);
  return hasChanges;
};


