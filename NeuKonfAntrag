interface SelectRowProps {
  beschreibung: string;
  label: string;
  value: string;
  name: string;
  disabled: boolean;
  onChange: (event: SelectChangeEvent) => void;
  dokumententype: Dokumententyp[];
}

const AntragseigenschaftSelect = ({
  beschreibung,
  label,
  onChange,
  value,
  name,
  disabled,
  dokumententype,
}: SelectRowProps) => {
  const selectedDokumententyp: Dokumententyp | undefined = dokumententype.find(
    (dokumententyp) => dokumententyp.schluessel === value
  );
  const handleClose = () => {
    if (!value) {
      const syntheticEvent = {
        target: { name, value: EpaAblageort.fallbackSchluessel },
      } as SelectChangeEvent;
      onChange(syntheticEvent);
    }
  };

  return (
    <TableRow>
      <TableCell sx={{ width: ThemeConstants.WIDTH_100_PERCENT }}>
        <Stack
          direction={ThemeConstants.DIRECTION_ROW}
          width={ThemeConstants.WIDTH_100_PERCENT}
          alignItems={ThemeConstants.ALIGNMENT_CENTER}
          justifyContent={ThemeConstants.CONTENT_ALIGN_SPACE_BETWEEN}
        >
          <DynamicTypography noWrap={true}>{beschreibung}</DynamicTypography>
          <FormControl size={ThemeConstants.SMALL} sx={{ minWidth: '50%' }}>
            <InputLabel>{label}</InputLabel>
            <Select
              value={value}
              name={name}
              displayEmpty
              onChange={onChange}
              onClose={handleClose}
              disabled={disabled}
              renderValue={() =>
                selectedDokumententyp
                  ? `${selectedDokumententyp.schluessel} ${selectedDokumententyp.beschreibung}`
                  : value
              }
            >
              {dokumententype.map((dokumententyp) => (
                <MenuItem key={dokumententyp.schluessel} value={dokumententyp.schluessel}>
                  {dokumententyp.schluessel + ' - ' + dokumententyp.beschreibung}
                </MenuItem>
              ))}
            </Select>
          </FormControl>
        </Stack>
      </TableCell>
      <TableCell />
    </TableRow>
  );
};

interface TextfieldRowProps {
  beschreibung: string;
  label: string;
  name: string;
  value: string | number;
  type: string;
  placeholder?: string;
  error?: boolean;
  helperText?: string;
  disabled: boolean;
