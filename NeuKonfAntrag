import { UuiServiceMessageType } from '@finanzinformatik/cpl-module-clientlib';
import { IcDownS, IcUpS } from '@finanzinformatik/mcd-module-icons';
import {
  Collapse,
  Grid,
  IconButton,
  Stack,
  Switch,
  TableCell,
  TableRow,
  Typography,
  useMediaQuery,
  useTheme,
} from '@mui/material';
import { addNotification, ThemeConstants } from '@personalsysteme/core';
import { useState } from 'react';
import { useTranslation } from 'react-i18next';
import { KonfAntragRead } from '../../../apl/pzw/konfigUiModule/KonfAntragRead';
import { KonfAntragsgruppeRead } from '../../../apl/pzw/konfigUiModule/KonfAntragsgruppeRead';
import { Dokumententyp } from '../../../apl/pzw/konfigUiModule/SvzSapEintragRead';
import { PzwThemeConstants } from '../../../constants/PzwThemeConstants';
import { useReadIsPersonalserviceAktiv } from '../../../tanstack/konfiguration/useReadIsPersonalserviceAktiv';
import { KonfAntragEigenschaftenPanel } from './KonfAntragEigenschaftenPanel';

interface KonfAntragsgruppenCollapsibleProps {
  antrag: KonfAntragRead;
  antragsgruppe: KonfAntragsgruppeRead;
  versionsnummer: string;
  buchungskreis: string;
  dokumententype: Dokumententyp[];
  onUnsavedChanges: (antragId: string, hasChanges: boolean) => void;
}

export const KonfAntragCollapsible = ({
  antrag,
  antragsgruppe,
  versionsnummer,
  buchungskreis,
  dokumententype,
  onUnsavedChanges,
}: KonfAntragsgruppenCollapsibleProps) => {
  const theme = useTheme();
  const isDesktop = useMediaQuery(theme.breakpoints.up('sm'));
  const [open, setOpen] = useState(false);
  const [antragAktiv, setAntragAktiv] = useState(antrag.isAktiv);
  const { t } = useTranslation();
  const { data: isAntragInPersonalservicesAktiv, isLoading: isAntragPSLoading } = useReadIsPersonalserviceAktiv(
    antrag.personalserviceSchluessel,
    Boolean(antrag.personalserviceSchluessel)
  );
  const isAntragAktiv =
    Boolean(antrag.personalserviceSchluessel) && !isAntragPSLoading && isAntragInPersonalservicesAktiv === false
      ? false
      : antragAktiv;
  const handleClickAktivitaetAendern = () => {
    if (Boolean(antrag.personalserviceSchluessel) && !isAntragPSLoading && isAntragInPersonalservicesAktiv === false) {
      addNotification(t('Info'), t('KonfigurationPersonalservicesMeldung'), UuiServiceMessageType.Info);
      return;
    }
    setAntragAktiv(!antragAktiv);
    setOpen(!antragAktiv);
  };
  if (isDesktop) {
    return (
      <>
        <TableRow>
          <TableCell component="th" scope="row">
            <Typography variant={ThemeConstants.TYPOGRAPHY_INPUT_01} noWrap={true}>
              {antrag.bezeichnung}
            </Typography>
          </TableCell>
          <TableCell width={PzwThemeConstants.PZW_KONFIGURATION_STATUS_TABLECELL_WIDTH}>
            {!isAntragPSLoading && (
              <Stack
                direction={ThemeConstants.DIRECTION_ROW}
                alignItems={ThemeConstants.ALIGNMENT_CENTER}
                spacing={2}
                justifyContent={ThemeConstants.CONTENT_ALIGN_SPACE_BETWEEN}
              >
                <Stack
                  direction={ThemeConstants.DIRECTION_ROW}
                  alignItems={ThemeConstants.ALIGNMENT_CENTER}
                  justifyContent={ThemeConstants.CONTENT_ALIGN_SPACE_BETWEEN}
                >
                  <Switch checked={isAntragAktiv} value={antragAktiv} onClick={handleClickAktivitaetAendern}></Switch>
                  <Typography variant={ThemeConstants.TYPOGRAPHY_LABEL_03} noWrap={true}>
                    {isAntragAktiv ? t('aktiviert') : t('deaktiviert')}
                  </Typography>
                </Stack>
                <IconButton
                  aria-label="expand row"
                  onClick={() => {
                    setOpen(!open);
                  }}
                >
                  {open ? <IcUpS /> : <IcDownS />}
                </IconButton>
              </Stack>
            )}
          </TableCell>
        </TableRow>
        <TableRow>
          <TableCell style={{ paddingBottom: 0, paddingTop: 0 }} colSpan={2}>
            <Collapse in={open} timeout="auto" unmountOnExit>
              <KonfAntragEigenschaftenPanel
                antragsgruppe={antragsgruppe}
                antrag={antrag}
                antragAktiv={antragAktiv}
                buchungskreis={buchungskreis}
                versionsnummer={versionsnummer}
                isAntragInPersonalservicesAktiv={isAntragInPersonalservicesAktiv}
                dokumententype={dokumententype}
                onUnsavedChanges={onUnsavedChanges}
              />
            </Collapse>
          </TableCell>
        </TableRow>
      </>
    );
  }
  return (
    <>
      <TableRow>
        <TableCell component="th" scope="row">
          <Grid container spacing={10}>
            <Grid size={{ xs: 12, lg: 8 }}>
              <Typography variant={ThemeConstants.TYPOGRAPHY_INPUT_01}> {antrag.bezeichnung}</Typography>
            </Grid>
            {!isAntragPSLoading && (
              <Grid size={{ xs: 10, lg: 8 }}>
                <Stack direction={ThemeConstants.DIRECTION_ROW} alignItems={ThemeConstants.ALIGNMENT_CENTER}>
                  <Switch checked={isAntragAktiv} value={antragAktiv} onClick={handleClickAktivitaetAendern}></Switch>
                  <Typography>{isAntragAktiv ? t('aktiviert') : t('deaktiviert')}</Typography>
                </Stack>
              </Grid>
            )}
            <Grid size={{ xs: 2, lg: 12 }}>
              <IconButton
                aria-label="expand row"
                onClick={() => {
                  if (antragAktiv || open) {
                    setOpen(!open);
                  }
                }}
              >
                {open ? <IcUpS /> : <IcDownS />}
              </IconButton>
            </Grid>
          </Grid>
        </TableCell>
      </TableRow>
      <TableRow>
        <TableCell style={{ paddingBottom: 0, paddingTop: 0 }} colSpan={4}>
          <Collapse in={open} timeout="auto" unmountOnExit>
            <KonfAntragEigenschaftenPanel
              antragsgruppe={antragsgruppe}
              antrag={antrag}
              antragAktiv={antragAktiv}
              buchungskreis={buchungskreis}
              versionsnummer={versionsnummer}
              isAntragInPersonalservicesAktiv={isAntragInPersonalservicesAktiv}
              dokumententype={dokumententype}
              onUnsavedChanges={onUnsavedChanges}
            />
          </Collapse>
        </TableCell>
      </TableRow>
    </>
  );
};
