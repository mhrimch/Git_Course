  return (
    <TableRow>
      <TableCell sx={{ width: ThemeConstants.WIDTH_100_PERCENT }}>
        <Stack
          direction={ThemeConstants.DIRECTION_ROW}
          width={ThemeConstants.WIDTH_100_PERCENT}
          alignItems={ThemeConstants.ALIGNMENT_CENTER}
          justifyContent={ThemeConstants.CONTENT_ALIGN_SPACE_BETWEEN}
        >
          <Typography noWrap={true}>{beschreibung} </Typography>
          <TextField
            size={ThemeConstants.SMALL}
            sx={{ minWidth: '50%' }}
            label={label}
            value={value}
            name={name}
            type={type}
            placeholder={placeholder}
            helperText={helperText}
            onChange={onChange}
            disabled={disabled}
            slotProps={slotProps}
            InputLabelProps={{ shrink: true }}
          />
        </Stack>
      </TableCell>
      <TableCell />
    </TableRow>
  );
};

interface AntraegeKonfigCheckboxPanelProps {
  versionsnummer: string;
  buchungskreis: string;
  antragsgruppe: KonfAntragsgruppeRead;
  antrag: KonfAntragRead;
  antragAktiv: boolean;
  isAntragInPersonalservicesAktiv?: boolean;
  dokumententype: Dokumententyp[];
  onUnsavedChanges: (antragId: string, hasChanges: boolean) => void;
}

export const KonfAntragEigenschaftenPanel = ({
  versionsnummer,
  buchungskreis,
  antrag,
  antragsgruppe,
  antragAktiv,
  isAntragInPersonalservicesAktiv,
  dokumententype,
  onUnsavedChanges,
}: AntraegeKonfigCheckboxPanelProps) => {
  const { t } = useTranslation();
  const [konfAntrag, setKonfAntrag] = useState<KonfAntragRead>(
    antrag.schluessel === AntragSchluessel.URLAUB ? { ...antrag, isGanztaegig: true } : antrag
  );
  const [urlTouched, setUrlTouched] = useState(false);
  const [urlError, setUrlError] = useState(false);
  const [anzahltageError, setAnzahlTageError] = useState(false);
  const { mutateAsync: updateKonfAntrag } = useUpdateKonfAntraege();
  const workflowService = useWorkflowService();
  const antragSchluessel = antrag.schluessel as AntragSchluessel;
  const isAntragOhneUhrzeit = [
    AntragSchluessel.Zeitkorrektur,
    AntragSchluessel.MehrarbeitBezahlt,
    AntragSchluessel.MehrarbeitInFreizeit,
    AntragSchluessel.ZeitgutschriftFreizeit,
    AntragSchluessel.ZeitgutschriftGleitzeit,
    AntragSchluessel.Verfallzeitgutschriften,
    AntragSchluessel.URLAUB,
  ].includes(antragSchluessel);
  const isAntragOhneGanzTaegig = [
    AntragSchluessel.Zeitkorrektur,
    AntragSchluessel.MehrarbeitBezahlt,
    AntragSchluessel.MehrarbeitInFreizeit,
    AntragSchluessel.ZeitgutschriftFreizeit,
    AntragSchluessel.ZeitgutschriftGleitzeit,
    AntragSchluessel.Verfallzeitgutschriften,
  ].includes(antragSchluessel);
  const isAntragOhneDokumentUpload = [
    AntragSchluessel.Zeitkorrektur,
    AntragSchluessel.MehrarbeitBezahlt,
    AntragSchluessel.MehrarbeitInFreizeit,
    AntragSchluessel.ZeitgutschriftFreizeit,
    AntragSchluessel.ZeitgutschriftGleitzeit,
    AntragSchluessel.Verfallzeitgutschriften,
  ].includes(antragSchluessel);
  const isUrlaubAntrag = antrag.schluessel === AntragSchluessel.URLAUB;
  const hasPersonalSchluessel = Boolean(konfAntrag.personalserviceSchluessel);
  const updateEigenschaft = (event: ChangeEvent<HTMLInputElement>) => {
    const updatedAntrag = { ...konfAntrag, [event.target.name]: event.target.checked };
    setKonfAntrag(updatedAntrag);
    pruefeAntragAufAenderung(antrag, updatedAntrag, onUnsavedChanges);
  };

  const handleFuehrungskraftFreigabeChange = (event: ChangeEvent<HTMLInputElement>) => {
    if (!event.target.checked && konfAntrag.isPersonalFreigabePflicht) {
      addNotification(t('Info'), t('GenehemigungFuehrungskraftErforderlich'), UuiServiceMessageType.Info);
      return;
    }
    const updatedAntrag = { ...konfAntrag, isFuehrungskraftFreigabePflicht: event.target.checked };
    setKonfAntrag(updatedAntrag);
    pruefeAntragAufAenderung(antrag, updatedAntrag, onUnsavedChanges);
  };

  const handlePersonalFreigabeChange = (event: ChangeEvent<HTMLInputElement>) => {
    if (event.target.checked && !konfAntrag.isFuehrungskraftFreigabePflicht) {
      addNotification(t('Info'), t('GenehemigungFuehrungskraftErforderlich'), UuiServiceMessageType.Info);
      return;
    }
    const updatedAntrag = { ...konfAntrag, isPersonalFreigabePflicht: event.target.checked };
    setKonfAntrag(updatedAntrag);
    pruefeAntragAufAenderung(antrag, updatedAntrag, onUnsavedChanges);
  };

  const handleDocumentUploadChange = (event: ChangeEvent<HTMLInputElement>) => {
    const checked = event.target.checked;
    const updatedAntrag = {
      ...konfAntrag,
      isDocumentUpload: checked,
      isDocumentUploadPflicht: checked ? konfAntrag.isDocumentUploadPflicht : false,
    };

    setKonfAntrag(updatedAntrag);
    pruefeAntragAufAenderung(antrag, updatedAntrag, onUnsavedChanges);
  };

  const handleGanztaegigChange = (event: ChangeEvent<HTMLInputElement>) => {
    if (!konfAntrag.isUhrzeit && konfAntrag.isGanztaegig) {
      addNotification(t('Info'), t('AktionAktivieren'), UuiServiceMessageType.Info);
      return;
    }
    const updatedAntrag = { ...konfAntrag, isGanztaegig: event.target.checked };
    setKonfAntrag(updatedAntrag);
    pruefeAntragAufAenderung(antrag, updatedAntrag, onUnsavedChanges);
  };

  const handleUhrzeitChange = (event: ChangeEvent<HTMLInputElement>) => {
    if (konfAntrag.isUhrzeit && !konfAntrag.isGanztaegig) {
      addNotification(t('Info'), t('AktionAktivieren'), UuiServiceMessageType.Info);
      return;
    }
    const updatedAntrag = { ...konfAntrag, isUhrzeit: event.target.checked };
    setKonfAntrag(updatedAntrag);
    pruefeAntragAufAenderung(antrag, updatedAntrag, onUnsavedChanges);
  };

  const handleAblageOrtSelect = (event: SelectChangeEvent) => {
    const updatedAntrag = {
      ...konfAntrag,
      epaArt: event.target.value,
    };
    setKonfAntrag(updatedAntrag);
    pruefeAntragAufAenderung(antrag, updatedAntrag, onUnsavedChanges);
  };

  const handleAnzahlTageChange = (event: ChangeEvent<HTMLInputElement>) => {
    const anzahlTage = event.target.value;
    if (anzahlTage === '') {
      const updatedAntrag = {
        ...konfAntrag,
        anzahlTageRueckwirkenderKorrektur: 0,
      };
      setKonfAntrag(updatedAntrag);
      pruefeAntragAufAenderung(antrag, updatedAntrag, onUnsavedChanges);
      return;
    }

    const parsedAnzahlTage = parseInt(anzahlTage, 10);
    if (!Number.isInteger(parsedAnzahlTage) || parsedAnzahlTage < 0 || parsedAnzahlTage > 180) {
      const updatedAntrag = { ...konfAntrag, anzahlTageRueckwirkenderKorrektur: parsedAnzahlTage };
      setAnzahlTageError(true);
      setKonfAntrag(updatedAntrag);
      pruefeAntragAufAenderung(antrag, updatedAntrag, onUnsavedChanges);
      return;
    }
    const updatedAntrag = { ...konfAntrag, anzahlTageRueckwirkenderKorrektur: parsedAnzahlTage };
    setAnzahlTageError(false);
    setKonfAntrag(updatedAntrag);
    pruefeAntragAufAenderung(antrag, updatedAntrag, onUnsavedChanges);
  };

  const handleUrlChange = (event: ChangeEvent<HTMLInputElement>) => {
    const value = event.target.value;
    const updatedAntrag = { ...konfAntrag, url: value };
    setKonfAntrag(updatedAntrag);
    pruefeAntragAufAenderung(antrag, updatedAntrag, onUnsavedChanges);
  };

  const handleUrlBlur = () => {
    setUrlTouched(true);
    if (konfAntrag.url.trim() === '') {
      setUrlError(false);
      return;
    }
    if (isValidHttpLink(konfAntrag.url)) {
      setUrlError(false);
    } else {
      setUrlError(true);
    }
  };

  const handleClickSpeichern = () => {
    if (hasPersonalSchluessel && !isAntragInPersonalservicesAktiv) {
      return;
    }
    if (!hasPersonalSchluessel && (anzahltageError || urlError)) {
      return;
    }
    const konfAntragWrite: KonfAntragWrite = {
      versionsnummer: versionsnummer,
      buchungskreis: buchungskreis,
      gruppenIconId: antragsgruppe.iconId,
      antragId: konfAntrag.id,
      hinweis: konfAntrag.hinweis,
      isAktiv: antragAktiv,
      isFavorit: konfAntrag.isFavorit,
      isFuehrungskraftFreigabePflicht: konfAntrag.isFuehrungskraftFreigabePflicht,
      isPersonalFreigabePflicht: konfAntrag.isPersonalFreigabePflicht,
      isKommentarPflicht: konfAntrag.isKommentarPflicht,
      isGanztaegig: isAntragOhneGanzTaegig ? false : konfAntrag.isGanztaegig,
      isUhrzeit: isAntragOhneUhrzeit ? false : konfAntrag.isUhrzeit,
      isSerienelement: konfAntrag.isSerienelement,
      isDocumentUpload: isAntragOhneDokumentUpload ? false : konfAntrag.isDocumentUpload,
      isDocumentUploadPflicht: isAntragOhneDokumentUpload ? false : konfAntrag.isDocumentUploadPflicht,
      epaArt: konfAntrag.epaArt,
      maxAnzahlTage: konfAntrag.maxAnzahlTage,
      maxAnzahlTageEinheit: konfAntrag.maxAnzahlTageEinheit,
      anzahlTageRueckwirkenderKorrektur: konfAntrag.anzahlTageRueckwirkenderKorrektur,
      url: konfAntrag.url,
      isUrl: konfAntrag.isUrl,
      verarbeitungsart: konfAntrag.verarbeitungsart,
      personalserviceSchluessel: konfAntrag.personalserviceSchluessel,
      personalserviceBezeichnung: konfAntrag.personalserviceBezeichnung,
      personalserviceKommentar: konfAntrag.personalserviceKommentar,
    };
    if (!pruefeAntragAufAenderung(antrag, konfAntrag)) {
      console.log(pruefeAntragAufAenderung(antrag, konfAntrag));
      console.log('nur navigieren');
      navigateToPskKonfiguration(workflowService);
      return;
    }
    console.log('updaten');
    updateKonfAntrag(konfAntragWrite).then(() => navigateToPskKonfiguration(workflowService));
  };

  return (
    <TableContainer>
      <Table>
        <TableHead>
          <TableRow>
            <TableCell>
              <Typography noWrap={true}>{t('Einstellungen') + ' ' + antrag.bezeichnung}</Typography>
            </TableCell>
            <TableCell width={ThemeConstants.WIDTH_100_PERCENT} />
          </TableRow>
        </TableHead>
        <TableBody>
          <AntragseigenschaftCheckbox
            key={'isFuehrungskraftFreigabePflicht'}
            beschreibung={t('GenehmigungFuehrungskraftErforderlich')}
            status={konfAntrag.isFuehrungskraftFreigabePflicht}
            name={'isFuehrungskraftFreigabePflicht'}
            onChange={handleFuehrungskraftFreigabeChange}
            disabled={hasPersonalSchluessel}
          />

          <AntragseigenschaftCheckbox
            key={'isPersonalFreigabePflicht'}
            beschreibung={t('ZentraleGenehmigungErforderlich')}
            status={konfAntrag.isPersonalFreigabePflicht}
            name={'isPersonalFreigabePflicht'}
            onChange={handlePersonalFreigabeChange}
            disabled={hasPersonalSchluessel}
            indent={true}
          />

          <AntragseigenschaftCheckbox
            key={'isKommentarPflicht'}
            beschreibung={t('KommentarAlsPflichtfeld')}
            status={konfAntrag.isKommentarPflicht}
            name={'isKommentarPflicht'}
            onChange={updateEigenschaft}
            disabled={hasPersonalSchluessel}
          />

          {!isAntragOhneUhrzeit && (
            <AntragseigenschaftCheckbox
              key={'isUhrzeit'}
              beschreibung={t('UhrzeitZulassen')}
              status={konfAntrag.isUhrzeit}
              name={'isUhrzeit'}
              onChange={handleUhrzeitChange}
              disabled={hasPersonalSchluessel}
            />
          )}

          {!isAntragOhneGanzTaegig && (
            <AntragseigenschaftCheckbox
              key={'isGanztaegig'}
              beschreibung={t('ganztaegigZulassen')}
              status={konfAntrag.isGanztaegig}
              name={'isGanztaegig'}
              onChange={handleGanztaegigChange}
              disabled={hasPersonalSchluessel || isUrlaubAntrag}
            />
          )}

          {!isAntragOhneDokumentUpload && (
            <AntragseigenschaftCheckbox
              key={'isDocumentUpload'}
              beschreibung={t('DokumentenUploadMoeglich')}
              status={konfAntrag.isDocumentUpload}
              name={'isDocumentUpload'}
              onChange={handleDocumentUploadChange}
              disabled={hasPersonalSchluessel}
            />
          )}
          {!isAntragOhneDokumentUpload && konfAntrag.isDocumentUpload && (
            <AntragseigenschaftCheckbox
              key={'isDocumentUploadPflicht'}
              beschreibung={t('DokumentenUploadPflicht')}
              status={konfAntrag.isDocumentUploadPflicht}
              name={'isDocumentUploadPflicht'}
              onChange={updateEigenschaft}
              disabled={hasPersonalSchluessel}
              indent={true}
            />
          )}
          {!isAntragOhneDokumentUpload && konfAntrag.isDocumentUpload && (
            <AntragseigenschaftSelect
              beschreibung={t('AblageortEpa')}
              label={'Dokumenententyp'}
              value={konfAntrag.epaArt}
              name={'epaArt'}
              onChange={handleAblageOrtSelect}
              dokumententype={dokumententype}
              disabled={hasPersonalSchluessel}
            ></AntragseigenschaftSelect>
          )}

          <AntragseigenschaftTextfield
            beschreibung={t('AnzahlTageRueckwirkenderKorrektur')}
            label={t('AnzahlTageRueckwirkenderKorrektur')}
            name={'anzahlTageRueckwirkenderKorrektur'}
            value={konfAntrag.anzahlTageRueckwirkenderKorrektur}
            type={'text'}
            helperText={anzahltageError ? t('ZugelasseneGanztaegigeWerte') : t('Max180Tage')}
            error={anzahltageError}
            onChange={handleAnzahlTageChange}
            disabled={hasPersonalSchluessel}
            slotProps={{
              input: {
                error: anzahltageError,
              },
            }}
          ></AntragseigenschaftTextfield>

          <AntragseigenschaftTextfield
            beschreibung={t('Intranetlink')}
            label={t('Intranetlink')}
            name={'url'}
            type={'text'}
            value={konfAntrag.url}
            placeholder={t('UrlEingeben')}
            helperText={urlTouched && urlError ? t('UngueltigesFormat') : undefined}
            onChange={handleUrlChange}
            disabled={hasPersonalSchluessel}
            slotProps={{
              input: {
                onBlur: handleUrlBlur,
                error: urlError,
                endAdornment: (
                  <InputAdornment position="end">
                    <Button
                      disabled={hasPersonalSchluessel}
                      onClick={() => {
                        if (isValidHttpLink(konfAntrag.url)) {
                          window.open(konfAntrag.url, '_blank');
                        }
                      }}
                    >
                      {t('linkOeffnen')}
                    </Button>
                  </InputAdornment>
                ),
              },
            }}
          />

          <TableRow>
            <TableCell>
              <Button variant="contained" size="large" onClick={handleClickSpeichern}>
                {t('Speichern')}
              </Button>
            </TableCell>
            <TableCell width={ThemeConstants.WIDTH_100_PERCENT} />
          </TableRow>
        </TableBody>
      </Table>
    </TableContainer>
  );
};
