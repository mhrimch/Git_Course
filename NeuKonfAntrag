interface KonfAntragsgruppenTableProps {
  antragsgruppe: KonfAntragsgruppeRead;
  versionsnummer: string;
  buchungskreis: string;
  dokumententype: Dokumententyp[];
  handleClickZurueckZuAntragsgruppen: () => void;
}

export const KonfAntragTable = ({
  antragsgruppe,
  versionsnummer,
  buchungskreis,
  dokumententype,
  handleClickZurueckZuAntragsgruppen,
}: KonfAntragsgruppenTableProps) => {
  const { t } = useTranslation();
  const theme = useTheme();
  const isDesktop = useMediaQuery(theme.breakpoints.up('sm'));
  const { ColorTokens } = useMcdPalette();
  const [antraegeMitChanges, setAntraegeMitChanges] = useState<Set<string>>(new Set());
  const [openDialog, setOpenDialog] = useState(false);
  const handleUnsavedChanges = (antragId: string, hasChanges: boolean) => {
    setAntraegeMitChanges((prev) => {
      const next = new Set(prev);
      if (hasChanges) {
        next.add(antragId);
        next.forEach((item) => console.log('antragID ', item));
        console.log('size ', next.size);
      } else {
        next.delete(antragId);
        next.forEach((item) => console.log('antragID ', item));
        console.log('size ', next.size);
      }
      return next;
    });
  };
  const handleClickZurueck = () => {
    if (antraegeMitChanges.size > 0) {
      console.log('es gibt Änderungen zum speichern');
      setOpenDialog(true);
      return;
    }
    setAntraegeMitChanges(new Set());
    handleClickZurueckZuAntragsgruppen();
  };

  return (
    <Stack spacing={4} width={ThemeConstants.WIDTH_100_PERCENT}>
      <Box>
        <Button size={'small'} onClick={handleClickZurueck} startIcon={<IcBackArrowS />}>
          {t('ZurueckZuAntraege')}
        </Button>
      </Box>
      <Stack spacing={ThemeConstants.GRID_CONTAINER_SPACING}>
        <Typography variant={ThemeConstants.TYPOGRAPHY_HEADLINE_02} noWrap={true}>
          {antragsgruppe.bezeichnung}
        </Typography>
        <TableContainer sx={{ border: 1, borderRadius: 2, borderColor: ColorTokens['ui-01'] }}>
          <Table aria-label="collapsible table">
            {isDesktop ? (
              <TableHeader />
            ) : (
              <TableRow>
                <TableCell>
                  <Typography variant={ThemeConstants.TYPOGRAPHY_HEADLINE_05}>Anträge</Typography>
                </TableCell>
              </TableRow>
            )}
            <TableBody>
              {antragsgruppe.antraege
                .slice()
                .sort((a, b) => a.rang - b.rang)
                .map((antrag) => (
                  <KonfAntragCollapsible
                    key={antrag.id}
                    antrag={antrag}
                    antragsgruppe={antragsgruppe}
                    versionsnummer={versionsnummer}
                    buchungskreis={buchungskreis}
                    dokumententype={dokumententype}
                    onUnsavedChanges={(antragId, hasChanges) => handleUnsavedChanges(antrag.id, hasChanges)}
                  />
                ))}
            </TableBody>
          </Table>
        </TableContainer>
      </Stack>
      <ConfirmationDialog
        title={t('Hinweis')}
        text={t('offeneAenderungen')}
        open={openDialog}
        onConfirm={(confirmed) => {
          if (confirmed) {
            handleClickZurueckZuAntragsgruppen();
          } else {
            setOpenDialog(false);
          }
        }}
      ></ConfirmationDialog>
    </Stack>
  );
};
