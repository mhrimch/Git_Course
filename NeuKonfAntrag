import { DynamicTypography, useWorkflowService } from '@finanzinformatik/cpl-module-reactlib';
import { IcBackArrowS } from '@finanzinformatik/mcd-module-icons';
import { Button, Grid } from '@mui/material';
import { MenuCard, MenuItem, ThemeConstants } from '@personalsysteme/core';
import { useState } from 'react';
import { useTranslation } from 'react-i18next';
import { KonfAntragskategorieRead } from '../../../apl/pzw/konfigUiModule/KonfAntragskategorieRead';
import { Dokumententyp } from '../../../apl/pzw/konfigUiModule/SvzSapEintragRead';
import { useReadKonfAntraege } from '../../../tanstack/konfiguration/useReadKonfAntraege';
import { navigateToPskKonfiguration } from '../../../utils/bookmarkUtil';
import { AntragAvatar } from '../../common/AntragAvatar';
import { KonfAntragsgruppen } from './KonfAntragsgruppen';

export const KonfAntraege = () => {
  const { t } = useTranslation();
  const workflowService = useWorkflowService();
  const [kategorieAuswahl, setKategorieAuswahl] = useState<KonfAntragskategorieRead | null>(null);
  const { data: konfAntraege, isFetching: isKonfAntraegeLoading } = useReadKonfAntraege();
  const dokumenententype: Dokumententyp[] = konfAntraege?.epaAblageorte
    ? [...konfAntraege.epaAblageorte]
        .sort((a, b) => a.rang - b.rang)
        .map(({ schluessel, beschreibung }) => ({ schluessel, beschreibung }))
    : [];
  const handleClickAntragKategorie = (kategorie: KonfAntragskategorieRead) => {
    setKategorieAuswahl(kategorie);
  };
  const handleClickZurueckZuKonfiguration = () => {
    navigateToPskKonfiguration(workflowService);
  };
  const handleClickZurueckZuAntraege = () => {
    setKategorieAuswahl(null);
  };
  if (!konfAntraege) {
    return <></>;
  }
  if (kategorieAuswahl) {
    return (
      <KonfAntragsgruppen
        antragskategorie={kategorieAuswahl}
        versionsnummer={konfAntraege.versionsnummer}
        buchungskreis={konfAntraege.buchungskreis}
        dokumententype={dokumenententype}
        handleClickZurueckZuAntraege={handleClickZurueckZuAntraege}
      />
    );
  }
  return (
    <Grid container justifyContent={ThemeConstants.CONTENT_ALIGN_FLEX_START}>
      <Grid size={12}>
        <Grid
          container
          justifyContent={ThemeConstants.CONTENT_ALIGN_FLEX_START}
          spacing={ThemeConstants.GRID_CONTAINER_SPACING}
          pb={10}
        >
          <Grid size={12}>
            <Button size="small" onClick={handleClickZurueckZuKonfiguration} startIcon={<IcBackArrowS />}>
              {t('ZurueckZurKonfiguration')}
            </Button>
          </Grid>
          <Grid size={12}>
            <DynamicTypography variant={ThemeConstants.TYPOGRAPHY_HEADLINE_02}>{t('Antraege')}</DynamicTypography>
          </Grid>
        </Grid>
        <Grid container spacing={ThemeConstants.GRID_CONTAINER_SPACING}>
          {!isKonfAntraegeLoading &&
            konfAntraege.antragskategorien
              .slice()
              .sort((a, b) => a.rang - b.rang)
              .map((kategorie) => {
                return (
                  <Grid key={kategorie.id} size={{ xs: 12, lg: 6 }}>
                    <MenuCard
                      menuItem={
                        {
                          avatarIcon: <AntragAvatar id={kategorie.iconId} groesse={ThemeConstants.AVATAR_SIZE_LG} />,
                          title: kategorie.bezeichnung,
                          description: kategorie.beschreibung,
                          onClick: () => handleClickAntragKategorie(kategorie),
                          isVisible: true,
                        } as MenuItem
                      }
                    />
                  </Grid>
                );
              })}
        </Grid>
      </Grid>
    </Grid>
  );
};

