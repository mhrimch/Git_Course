import { IcCancelCircleS, IcCheckCircleS, IcCircleEmptyDotsS } from '@finanzinformatik/mcd-module-icons';
import { Chip } from '@mui/material';
import { AntragStatusRead } from '../../apl/pzw/antragUiModule/AntragStatusRead';
import { AntragStatus } from '../../constants/AntragConstants';

interface AntragStatusChipProps {
  antragStatus: AntragStatusRead;
}
export function AntragStatusChip({ antragStatus }: AntragStatusChipProps) {
  switch (antragStatus.status) {
    case AntragStatus.ZurGenehmigung:
      return <Chip icon={<IcCircleEmptyDotsS />} color="attention" label={antragStatus.bezeichnung} />;
    case AntragStatus.Storniert:
      return <Chip icon={<IcCancelCircleS />} color="error" label={antragStatus.bezeichnung} />;
    case AntragStatus.Abgelehnt:
      return <Chip icon={<IcCancelCircleS />} color="error" label={antragStatus.bezeichnung} />;
    case AntragStatus.Freigegeben:
    case AntragStatus.FreigegebenSAP:
      return <Chip icon={<IcCheckCircleS />} color="success" label={antragStatus.bezeichnung} />;
    default:
      return <></>;
  }
}
