}

export const AntragAbwesenheitItem = ({
  iconId,
  bezeichnung,
  antragGruppeId,
  antragSchluessel,
  isExtern,
  personalserviceSchluessel,
}: AntragItemProps) => {
  const workflowService = useWorkflowService();
  const notificationStoreActions = useNotificationStoreActions();
  const actionDisallowed: boolean = isPersonalserviceAktiv(personalserviceSchluessel, Boolean(isExtern)).data === false;

  function onClick() {
    if (actionDisallowed) {
      notificationStoreActions.addErrorNotification(t('AntraegeUebersicht.Fehler.PersonalServiceInaktiv'));
      return;
    }
    const host = window.location.hostname.toLowerCase();
    const prefix = host.substring(0, 2);

    let dynamicProcessId: string;

    switch (prefix) {
      case 'en':
        dynamicProcessId = 'fi-ps-en';
        break;
      case 'in':
        dynamicProcessId = 'fi-ps-in';
        break;
      case 'an':
        dynamicProcessId = 'fi-ps-an';
        break;
      default:
        dynamicProcessId = 'fi-ps-prod';
    }

    if (isExtern) {
      //https://wiki.intern/spaces/pem/pages/646271824/Design+Aufruf+Personalservice
      workflowService.startWorkflow('dynprocpl', 'interpreter', 1, {
        input: {
          language: 'de-DE',
          processData: {
            processId: dynamicProcessId,
            processParameters: {
              mkpParameter: personalserviceSchluessel,
            },
          },
        },
      });
    }

    if (!isExtern) {
      navigateToAntragAnlegen(workflowService, {
        antragGruppeId,
        antragSchluessel,
      });
    }
  }

  return <InfoCard isExternal={isExtern} title={bezeichnung} onClick={onClick} iconId={iconId} />;
};

