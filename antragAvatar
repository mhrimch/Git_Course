export function AntragAvatar({ id, groesse = 'sm', text }: AntragAvatarProps) {
  const categoryColors = useMcdPalette().ColorCategoryTokens;
  const config: AvatarIconConfig | undefined = categoryConfigs[id];
  if (!config) {
    return undefined;
