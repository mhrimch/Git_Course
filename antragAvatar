type AntragItemProps = {
  iconId: number;
  bezeichnung: string;
  antragGruppeId: string;
  antragSchluessel?: string;
  isExtern?: boolean;
};

type CategoryIconConfig = {
  Icon: (props: SvgIconProps) => ReactElement;
  color: string;
  backgroundColor: string;
};
export function getIconConfiguration(iconId: number) {
  const colors = useMcdPalette().ColorCategoryTokens;
  const categoryConfigs: Record<number, CategoryIconConfig> = {
    //Zeitkorrektur
    0: {
      color: colors['category-garden-01'],
      backgroundColor: colors['category-garden-02'],
      Icon: IcClockS,
    },
    //Urlaub
    1: {
      color: colors['category-travel-01'],
      backgroundColor: colors['category-travel-02'],
      Icon: IcPlaneS,
    },
    //Sonstiges
    2: {
      color: colors['category-mobility-01'],
      backgroundColor: colors['category-mobility-02'],
      Icon: IcRoomS,
    },
    //Bildung
    3: {
      color: colors['category-education-01'],
      backgroundColor: colors['category-education-02'],
      Icon: IcBachelorCapS,
    },
    //Gesundheit
    4: {
      color: colors['category-health-01'],
      backgroundColor: colors['category-health-02'],
      Icon: IcHeartDiagramS,
    },
    //Persoenlich
    5: {
      color: colors['category-protection-01'],
      backgroundColor: colors['category-protection-02'],
      Icon: IcUserS,
    },
  };
  return (
    categoryConfigs[iconId] ?? {
      color: colors['category-mobility-01'],
      backgroundColor: colors['category-mobility-02'],
      Icon: IcRoomS,
    }
  );
}

export function AntragIcon({
  iconId,
  size = ThemeConstants.AVATAR_SIZE_48,
  iconSize = 'auto',
}: {
  iconId: number;
  size?: number | string;
  iconSize?: number | string;
}) {
  const { color, backgroundColor, Icon } = getIconConfiguration(iconId);
  return (
    <Avatar
      sx={{
        height: size,
        width: size,
        bgcolor: backgroundColor,
      }}
    >
      <Icon sx={{ fill: color, maxHeight: iconSize, maxWidth: iconSize }} />
    </Avatar>
  );
}

export default function AntragAbwesenheitItem({
  iconId,
  bezeichnung,
  antragGruppeId,
  antragSchluessel,
  isExtern,
}: AntragItemProps) {
  const workflowService = useWorkflowService();
  function onClick() {
    const host = window.location.hostname.toLowerCase(),
      prefix = host.substring(0, 2);

    let dynamicProcessId: string;

    switch (prefix) {
      case 'en':
        dynamicProcessId = 'fi-ps-en';
        break;
      case 'in':
        dynamicProcessId = 'fi-ps-in';
        break;
      case 'an':
        dynamicProcessId = 'fi-ps-an';
        break;
      default:
        dynamicProcessId = 'fi-ps-prod';
    }

    if (isExtern) {
      //https://wiki.intern/spaces/pem/pages/646271824/Design+Aufruf+Personalservice
      workflowService.startWorkflow('dynprocpl', 'interpreter', 1, {
        input: {
          language: 'de-DE',
          processData: {
            processId: dynamicProcessId,
            processParameters: {
              mkpParameter: antragGruppeId,
            },
          },
        },
      });
    }

    if (!isExtern) {
      navigateToAntragAbwesenheitAnlegen(workflowService, { antragGruppeId, antragSchluessel });
    }
  }
  return <InfoCard isExternal={isExtern} title={bezeichnung} onClick={onClick} iconId={iconId} />;
}

