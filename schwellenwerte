// @see "CR602Dokumentation"
import {
    FormControl,
    FormHelperText,
    InputAdornment,
    SxProps,
    TextField,
    TextFieldProps,
    Theme,
    Typography,
} from '@mui/material';
import { Control, Controller, FieldPath, FieldValues, useFormContext } from 'react-hook-form';
import { LocalesConstants, NumberConstants, ThemeConstants } from '../Constants';
import { convertNumberToGermanString, getOnlyNumericWithDecimalString } from '../Util';
import { FormInputSkeleton } from './FormInputSkeleton';

interface FormInputNumberProps<TFieldValues extends FieldValues, TTransformedValues = TFieldValues> extends Omit<
  TextFieldProps,
  'name'
> {
  name: FieldPath<TFieldValues>;
  label: string;
  oldValue?: number;
  disabled?: boolean;
  minimumFractionDigits?: number;
  maximumFractionDigits?: number;
  valueType?: string;
  onDependencyChange?: (number: number) => void;
  isLoading?: boolean;
  max?: number;
  min?: number;
  control?: Control<TFieldValues, unknown, TTransformedValues>;
  sx?: SxProps<Theme>;
  showTrailingZeros?: boolean;
}

/**
 * Generische Komponente für numerische Eingaben mit Validierung.
 * @template T - Typ der Formulardaten
 * @param {Object} props - Komponenteneigenschaften
 * @param {Path<T>} props.name - Feldname im Formular
 * @param {string} props.label - Beschriftung des Feldes
 * @param {number} props.oldValue - Alt-Wert des Feldes
 * @param {number} [props.minimumFractionDigits] - minimale Anzahl der Dezimalstellen
 * @param {number} [props.maximumFractionDigits] - maximale Anzahl der Dezimalstellen
 * @param {string} [props.valueType] - Einheit des Wertes
 * @param {Function} [props.onDependencyChange] - Funktion, welches bei Änderung des Watch-Wertes ausgeführt wird
 * @param {boolean} [props.isLoading] - Gibt an ob die Liste noch geladen wird
 * @param {number} [props.max] - Gibt an welche Number maximal angegeben werden muss und überschreibt sie damit wenn größer
 * @param {number} [props.min] - Gibt an welche Number minimal angegeben werden muss und überschreibt sie damit wenn kleiner
 * @param {Control<T> | undefined} [props.control] - Verwendet die übergebene control statt des useFormContext
 * @param {SxProps<Theme>} [props.sx] - MUI-Styling-Eigenschaften
 * @param {boolean} [props.showTrailingZeros] - Gibt an, ob nachfolgende Nullen angezeigt werden sollen. Standardwert: 'false'
 * @example
 * <FormInputNumber name="alter" label="Alter" maximumFractionDigits={0} valueType="Jahre" />
 */
export const FormInputNumber = <TFieldValues extends FieldValues, TTransformedValues = TFieldValues>({
  name,
  label,
  oldValue,
  disabled,
  minimumFractionDigits = NumberConstants.TWO_DIGITS,
  maximumFractionDigits = NumberConstants.TWO_DIGITS,
  valueType,
  onDependencyChange,
  sx,
  isLoading,
  max,
  min,
  control,
  showTrailingZeros = false,
  ...mui
}: FormInputNumberProps<TFieldValues, TTransformedValues>) => {
  const { control: contextControl } = useFormContext<TFieldValues, unknown, TTransformedValues>();

  return (
    <FormControl fullWidth={true}>
      <Controller<TFieldValues, FieldPath<TFieldValues>, TTransformedValues>
        name={name}
        control={control ?? contextControl}
        render={({ field, fieldState: { error } }) => (
          <FormInputSkeleton isLoading={isLoading}>
            <TextField
              label={label}
              // Die Prüfung verhindert die Formatierung von leeren oder ungültigen Werten, da `field.value` auch `undefined` oder `Nan` sein kann.
              value={showTrailingZeros && typeof field.value === 'number' && !isNaN(field.value)
                  ? field.value.toFixed(minimumFractionDigits)
                  : field.value}
              onChange={(e) => {
                const numberString = getOnlyNumericWithDecimalString(e.target.value);
                const num = Number(numberString);
                let newValue = numberString;
                if (max && !isNaN(num) && num > max) {
                  newValue = Number(max).toFixed(maximumFractionDigits);
                } else if (min && !isNaN(num) && num < min) {
                  newValue = Number(min).toFixed(minimumFractionDigits);
                }
                field.onChange(newValue);
                if (onDependencyChange) {
                  onDependencyChange(parseFloat(newValue));
                }
              }}
              onBlur={(e) => {
                const value = parseFloat(getOnlyNumericWithDecimalString(e.target.value));
                if (!isNaN(value)) {
                  const rounded = parseFloat(value.toFixed(maximumFractionDigits));
                    // `toFixed` wird verwendet, um die gewünschte Anzahl Nachkommastellen inklusive nachfolgender Nullen anzuzeigen.
                  field.onChange(showTrailingZeros ? rounded.toFixed(minimumFractionDigits) : rounded);
                }
              }}
              disabled={disabled}
              error={Boolean(error)}
              slotProps={{
                htmlInput: {
                  step: maximumFractionDigits > 0 ? `0.${'1'.padStart(maximumFractionDigits ?? 0 , '0')}` : '1',
                  min: 0,
                  pattern: `^\\d+(\\.\\d{1,${maximumFractionDigits}})?$`,
                  lang: LocalesConstants.LOCALES_DE_DE,
                },
                input: {
                  endAdornment: (
                    <InputAdornment position="end" sx={{ width: '100%', pointerEvents: 'none' }}>
                      <Typography
                        component={'div'}
                        sx={{
                          display: 'flex',
                          justifyContent: ThemeConstants.CONTENT_ALIGN_SPACE_BETWEEN,
                          width: '100%',
                          alignItems: 'center',
                          fontSize: 'inherit',
                          color: disabled ? 'text.disabled' : 'text.primary',
                        }}
                      >
                        {oldValue !== undefined && (
                          <span>{`vorher: ${convertNumberToGermanString(oldValue, minimumFractionDigits, maximumFractionDigits)}`}</span>
                        )}
                        {valueType !== undefined && <span> {valueType}</span>}
                      </Typography>
                    </InputAdornment>
                  ),
                },
              }}
              sx={sx}
              {...mui}
            />
            <FormHelperText error>{error?.message}</FormHelperText>
          </FormInputSkeleton>
        )}
      />
    </FormControl>
  );
};

