const formSchemaKonfSchwellenwerte = (t: TFunction) =>
  z
    .object({
      gleitzeitsaldoVollzeit: z.object({
        negativerRotbereich: z.object({
          wert: z.number(),
        }),
        negativerGelbbereich: z.object({
          wert: z.number(),
        }),
        positiverGelbbereich: z.object({
          wert: z.number(),
        }),
        positiverRotbereich: z.object({
          wert: z.number(),
        }),
      }),
      gleitzeitsaldoTeilzeit: z.object({
        negativerRotbereich: z.object({
          wert: z.number(),
        }),
        negativerGelbbereich: z.object({
          wert: z.number(),
        }),
        positiverGelbbereich: z.object({
          wert: z.number(),
        }),
        positiverRotbereich: z.object({
          wert: z.number(),
        }),
      }),
      urlaub: z.object({
        resturlaub: z.object({
          wert: z.number().min(0).max(KonfigurationConstants.SCHWELLENWERTE_URLAUB_MAX_ANZAHL_TAGE_RESTURLAUB),
        }),
        neutralerBereich: z.object({
          wert: z.number().min(0).max(KonfigurationConstants.SCHWELLENWERTE_URLAUB_MAX_ANZAHL_TAGE_NEUTRALER_BEREICH),
        }),
        gelbbereich: z.object({
          wert: z.number().min(0).max(PzwConstants.ANZAHL_TAGE_IM_JAHR),
        }),
        rotbereich: z.object({
          wert: z.number().min(0).max(PzwConstants.ANZAHL_TAGE_IM_JAHR),
        }),
      }),
      isTeilzeitVollzeitIdentisch: z.boolean(),
    })
    .superRefine((data, ctx) => {
      // Vollzeit
      if (
        data.gleitzeitsaldoVollzeit.negativerRotbereich.wert >= data.gleitzeitsaldoVollzeit.negativerGelbbereich.wert
      ) {
        ctx.addIssue({
          code: 'custom',
          message: t('Schwellenwerte.GleitzeitsaldoVollzeitkraft.NegativerRotbereich.Fehler'),
          path: ['gleitzeitsaldoVollzeit.negativerRotbereich.wert'],
        });
        ctx.addIssue({
          code: 'custom',
          message: t('Schwellenwerte.GleitzeitsaldoVollzeitkraft.NegativerGelbbereich.Fehler'),
          path: ['gleitzeitsaldoVollzeit.negativerGelbbereich.wert'],
        });
      }
      if (
        data.gleitzeitsaldoVollzeit.positiverGelbbereich.wert >= data.gleitzeitsaldoVollzeit.positiverRotbereich.wert
      ) {
        ctx.addIssue({
          code: 'custom',
          message: t('Schwellenwerte.GleitzeitsaldoVollzeitkraft.PositiverGelbbereich.Fehler'),
          path: ['gleitzeitsaldoVollzeit.positiverGelbbereich.wert'],
        });
        ctx.addIssue({
          code: 'custom',
          message: t('Schwellenwerte.GleitzeitsaldoVollzeitkraft.PositiverRotbereich.Fehler'),
          path: ['gleitzeitsaldoVollzeit.positiverRotbereich.wert'],
        });
      }
      // Teilzeit
      if (
        data.gleitzeitsaldoTeilzeit.negativerRotbereich.wert >= data.gleitzeitsaldoTeilzeit.negativerGelbbereich.wert
      ) {
        ctx.addIssue({
          code: 'custom',
          message: t('Schwellenwerte.GleitzeitsaldoTeilzeitkraft.NegativerRotbereich.Fehler'),
          path: ['gleitzeitsaldoTeilzeit.negativerRotbereich.wert'],
        });
        ctx.addIssue({
          code: 'custom',
          message: t('Schwellenwerte.GleitzeitsaldoTeilzeitkraft.NegativerGelbbereich.Fehler'),
          path: ['gleitzeitsaldoTeilzeit.negativerGelbbereich.wert'],
        });
      }
      if (
        data.gleitzeitsaldoTeilzeit.positiverGelbbereich.wert >= data.gleitzeitsaldoTeilzeit.positiverRotbereich.wert
      ) {
        ctx.addIssue({
          code: 'custom',
          message: t('Schwellenwerte.GleitzeitsaldoTeilzeitkraft.PositiverGelbbereich.Fehler'),
          path: ['gleitzeitsaldoTeilzeit.positiverGelbbereich.wert'],
        });
        ctx.addIssue({
          code: 'custom',
          message: t('Schwellenwerte.GleitzeitsaldoTeilzeitkraft.PositiverRotbereich.Fehler'),
          path: ['gleitzeitsaldoTeilzeit.positiverRotbereich.wert'],
        });
      }
      // Urlaub
      if (data.urlaub.gelbbereich.wert >= data.urlaub.neutralerBereich.wert) {
        ctx.addIssue({
          code: 'custom',
          message: t('Schwellenwerte.Urlaubsuebersicht.Gelbbereich.FehlerNeutral'),
          path: ['urlaub.gelbbereich.wert'],
        });
        ctx.addIssue({
          code: 'custom',
          message: t('Schwellenwerte.Urlaubsuebersicht.NeutralerBereich.Fehler'),
          path: ['urlaub.neutralerBereich.wert'],
        });
      }
      if (data.urlaub.rotbereich.wert >= data.urlaub.gelbbereich.wert) {
        ctx.addIssue({
          code: 'custom',
          message: t('Schwellenwerte.Urlaubsuebersicht.Rotbereich.Fehler'),
          path: ['urlaub.rotbereich.wert'],
        });
        ctx.addIssue({
          code: 'custom',
          message: t('Schwellenwerte.Urlaubsuebersicht.Gelbbereich.FehlerGelb'),
          path: ['urlaub.gelbbereich.wert'],
        });
      }
      // Cross-side - übergreifend
      if (
        data.gleitzeitsaldoVollzeit.negativerGelbbereich.wert >= data.gleitzeitsaldoVollzeit.positiverGelbbereich.wert
      ) {
        ctx.addIssue({
          code: 'custom',
          message: t('Schwellenwerte.Gleitzeitsaldo.AbgrenzungFehler'),
          path: ['gleitzeitsaldoVollzeit.negativerGelbbereich.wert'],
        });
      }
      if (
        data.gleitzeitsaldoTeilzeit.negativerGelbbereich.wert >= data.gleitzeitsaldoTeilzeit.positiverGelbbereich.wert
      ) {
        ctx.addIssue({
          code: 'custom',
          message: t('Schwellenwerte.Gleitzeitsaldo.AbgrenzungFehler'),
          path: ['gleitzeitsaldoTeilzeit.negativerGelbbereich.wert'],
        });
      }
    });
export type KonfSchwellenwerteFormType = z.infer<ReturnType<typeof formSchemaKonfSchwellenwerte>>;

export default function KonfSchwellenwerteView() {
  const { t } = useTranslation();
  const inputModel = useInputModel<{ canUpdateSchwellenwerte: boolean }>();
  const { data: schwellenwerte, isLoading: isKonfSchwellenwerteLoading, refetch } = useReadKonfSchwellenwerte();
  const { mutate: updateSchwellenwerte, isPending: isKonfSchwellenwerteUpdating } = useUpdateKonfSchwellenwerte();
  const workflowService = useWorkflowService();
  const methods = useForm<KonfSchwellenwerteFormType, unknown, KonfSchwellenwerteFormType>({
    resolver: zodResolver(formSchemaKonfSchwellenwerte(t)),
    mode: 'all',
    reValidateMode: 'onBlur',
    defaultValues: async () => {
      const { data } = await refetch();
      return data ?? ({} as KonfSchwellenwerteFormType);
    },
    values: schwellenwerte,
  });
  const handleClickZurueckZuKonfiguration = () => {
    navigateToPskKonfiguration(workflowService);
  };

  const handleFormSubmit = () => {
    updateSchwellenwerte(methods.getValues() as KonfSchwellenwerteRW);
  };

  /*
   * Workaround für cross-side-validation (zod/react-hook-form validiert bei Änderungen nur betroffenes Feld)
   * TODO: Arash/Jan Prüfung auf Korrektur/Erweiterung in PSK-core
   */
  useEffect(() => {
    const sub = methods.watch((_) => {
      methods.trigger().then(() => {
        // Nur Auslöser ohne weitere Behandlung.
      });
    });
    return () => sub.unsubscribe();
  }, [methods.watch, methods.trigger]);

  return (
    <Grid container spacing={ThemeConstants.GRID_CONTAINER_SPACING} justifyContent={ThemeConstants.ALIGNMENT_CENTER}>
      <Grid size={{ xs: 12, lg: 10 }}>
        <FormProviderWrapper<KonfSchwellenwerteFormType>
          formId={'konfiguration-schwellenwerte'}
          methods={methods}
          onSubmit={handleFormSubmit}
        >
          <Grid
            container
            spacing={ThemeConstants.GRID_CONTAINER_SPACING}
            justifyContent={ThemeConstants.ALIGNMENT_CENTER}
            gap={5}
          >
            <Grid size={12}>
              <Button size="small" onClick={handleClickZurueckZuKonfiguration} startIcon={<IcBackArrowS />}>
                {t('ZurueckZurKonfiguration')}
              </Button>
            </Grid>
            <Grid size={12}>
              <Typography variant={ThemeConstants.TYPOGRAPHY_HEADLINE_02} component="div">
                {t('Schwellenwerte.Schwellenwerte')}
              </Typography>
            </Grid>

            {isKonfSchwellenwerteLoading ? (
              <>
                <Skeleton variant="rectangular" width={ThemeConstants.WIDTH_100_PERCENT} height={20} />
                <Skeleton variant="rectangular" width={ThemeConstants.WIDTH_100_PERCENT} height={20} />
                <Skeleton variant="rectangular" width={ThemeConstants.WIDTH_100_PERCENT} height={20} />
              </>
            ) : (
              <Grid size={12}>
                <Accordion sx={{ border: '1px solid #E3E3E3 !important' }}>
                  <AccordionSummary>
                    <Typography variant={ThemeConstants.TYPOGRAPHY_INPUT_01}>
                      {t('Schwellenwerte.GleitzeitsaldoVollzeitkraft.GleitzeitsaldoVollzeitkraft')}
                    </Typography>
                  </AccordionSummary>
                  <AccordionDetails>
                    <KonfGleitzeitsaldoVollzeitkraft methods={methods} />
                  </AccordionDetails>
                </Accordion>

                <Accordion sx={{ border: '1px solid #E3E3E3 !important' }}>
                  <AccordionSummary>
                    <Typography variant={ThemeConstants.TYPOGRAPHY_INPUT_01}>
                      {t('Schwellenwerte.GleitzeitsaldoTeilzeitkraft.GleitzeitsaldoTeilzeitkraft')}
                    </Typography>
                  </AccordionSummary>
                  <AccordionDetails>
                    <KonfGleitzeitsaldoTeilzeitkraft methods={methods} />
                  </AccordionDetails>
                </Accordion>

                <Accordion sx={{ border: '1px solid #E3E3E3 !important' }}>
                  <AccordionSummary>
                    <Typography variant={ThemeConstants.TYPOGRAPHY_INPUT_01}>
                      {t('Schwellenwerte.Urlaubsuebersicht.Urlaubsuebersicht')}
                    </Typography>
                  </AccordionSummary>
                  <AccordionDetails>
                    <KonfUrlaubsuebersicht methods={methods} />
                  </AccordionDetails>
                </Accordion>
              </Grid>
            )}
          </Grid>
          <Grid size={12} paddingTop={5}>
            <Button
              variant={ThemeConstants.BUTTON_VARIANT_CONTAINED}
              type={'submit'}
              loading={isKonfSchwellenwerteUpdating}
              disabled={!inputModel?.canUpdateSchwellenwerte}
            >
              {t('Speichern')}
            </Button>
          </Grid>
        </FormProviderWrapper>
      </Grid>
    </Grid>
  );
