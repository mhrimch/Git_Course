import { ButtonBase, Card, CardContent } from '@mui/material';
import { ThemeConstants } from '@personalsysteme/core';
import { InfoCardContent } from './InfoCardContent';

interface InfoCardRotbereichProps {
  title: string;
  anzahlMitarbeiterRotbereich: number | undefined;
  isInteraktiv?: boolean;
  isPending: boolean;
  onClick?: () => void;
}

export function InfoCardRotbereich({
  title,
  anzahlMitarbeiterRotbereich,
  isInteraktiv,
  isPending,
  onClick,
}: InfoCardRotbereichProps) {
  return (
    <ButtonBase
      disabled={isInteraktiv}
      sx={{ minWidth: 275, width: ThemeConstants.WIDTH_100_PERCENT }}
      onClick={onClick}
    >
      <Card sx={{ width: ThemeConstants.WIDTH_100_PERCENT }}>
        <CardContent>
          <InfoCardContent
            title={title}
            isPending={isPending}
            anzahlMitarbeiterRotbereich={anzahlMitarbeiterRotbereich}
          ></InfoCardContent>
        </CardContent>
      </Card>
    </ButtonBase>
  );
}
