import { DynamicTypography } from '@finanzinformatik/cpl-module-reactlib';
import { Avatar, Skeleton } from '@mui/material';
import { Stack } from '@mui/system';
import { ThemeConstants } from '@personalsysteme/core';
import { useTranslation } from 'react-i18next';

function AnzahlMitarbeiterRotbereich({
  isPending,
  anzahlMitarbeiterRotbereich,
}: {
  isPending: boolean;
  anzahlMitarbeiterRotbereich: number | undefined;
}) {
  if (isPending) {
    return (
      <Skeleton
        variant={ThemeConstants.VARIANT_CIRCULAR}
        width={ThemeConstants.AVATAR_SIZE_SM}
        height={ThemeConstants.AVATAR_SIZE_SM}
        animation={ThemeConstants.ANIMATION_WAVE}
      ></Skeleton>
    );
  }

  return (
    <>
      <Avatar
        data-size={ThemeConstants.SMALL}
        variant={ThemeConstants.VARIANT_CIRCULAR}
        data-color={ThemeConstants.WARNING}
      >
        {anzahlMitarbeiterRotbereich}
      </Avatar>
    </>
  );
}

interface InfoCardContentProps {
  title: string;
  isPending: boolean;
  anzahlMitarbeiterRotbereich: number | undefined;
}

export function InfoCardContent({ title, isPending, anzahlMitarbeiterRotbereich }: InfoCardContentProps) {
  const { t } = useTranslation();
  return (
    <Stack
      direction={ThemeConstants.DIRECTION_ROW}
      alignItems={'justifyContent'}
      justifyContent={ThemeConstants.CONTENT_ALIGN_SPACE_BETWEEN}
    >
      <Stack direction={ThemeConstants.DIRECTION_COLUMN} alignItems="start">
        <DynamicTypography variant={ThemeConstants.TYPOGRAPHY_HEADLINE_04}>{title}</DynamicTypography>
        <DynamicTypography variant={ThemeConstants.TYPOGRAPHY_MULTILINE_02}>
          {t('MitarbeiterRotBereich')}
        </DynamicTypography>
      </Stack>
      <AnzahlMitarbeiterRotbereich
        isPending={isPending}
        anzahlMitarbeiterRotbereich={anzahlMitarbeiterRotbereich}
      ></AnzahlMitarbeiterRotbereich>
    </Stack>
  );
}

