import { useMcdPalette } from '@finanzinformatik/mcd-module-theme-provider';
import { Badge } from '@mui/material';
import Grid from '@mui/material/Grid';
import Typography from '@mui/material/Typography';
import { GleitzeitsalRotbereich } from './GeitzeitsaldoRotbereich';
import ResturlaubRotbereich from './ResturlaubRotbereich';

function Anzahl({ anzahl }: { anzahl: number }) {
  const categoryColors = useMcdPalette().ColorCategoryTokens;
  return (
    <Badge
      sx={{
        width: 32,
        height: 32,
        borderRadius: '50%',
        backgroundColor: categoryColors['category-health-02'],
        display: 'flex',
        alignItems: 'center',
        justifyContent: 'center',
      }}
    >
      <Typography variant="h6" fontWeight="bold" sx={{ color: categoryColors['category-health-01'] }}>
        {anzahl}
      </Typography>
    </Badge>
  );
}

interface AmpelkontoUebersichtProps {
  gleitzeitsaldoAnzahl: number;
  resturlaubAnzahl: number;
}

export function AmpelkontoUebersicht({ gleitzeitsaldoAnzahl, resturlaubAnzahl }: AmpelkontoUebersichtProps) {
  return (
    <Grid container justifyContent="center" spacing={10} flexDirection="column" sx={{ width: '100%' }} gap={0}>
      {/* Überschrift */}
      <Grid container justifyContent="space-between" alignItems="center" spacing={1} margin={3}>
        <Grid size={{ xs: 12, sm: 6 }}>
          <Typography variant="headline02">Ampelkonto</Typography>
        </Grid>
      </Grid>

      {/* Karten */}
      <Grid container size={12} justifyContent="flex-start" alignItems="center" spacing={3}>
        <Grid size={{ xs: 12, md: 6 }}>
          <GleitzeitsalRotbereich anzahlMitarbeiter={gleitzeitsaldoAnzahl} />
        </Grid>
        <Grid size={{ xs: 12, md: 6 }}>
          <ResturlaubRotbereich anzahlMitarbeiter={resturlaubAnzahl} />
        </Grid>
      </Grid>
    </Grid>
  );
}


