import { HttpMethod, UuiServiceClient, UuiServiceResponse } from '@finanzinformatik/cpl-module-reactlib';
import { App, Services } from '../../../constants/ServiceConstants';
import { DokumentRead } from './DokumentRead';
import { DokumentWrite } from './DokumentWrite';

export const callDownloadFileByDownloadToken = async (
  uuiService: UuiServiceClient,
  downloadToken: string
): Promise<UuiServiceResponse<string>> => {
  return uuiService.execute<string>({
    method: HttpMethod.Get,
    app: App.PZW,
    module: Services.DokumenteUiModule.module,
    service: Services.DokumenteUiModule.services.downloadFileByDownloadToken,
    params: { downloadToken: downloadToken },
  });
};

export const callUploadFileByBase64 = async (
  uuiService: UuiServiceClient,
  dokumentWrite: DokumentWrite
): Promise<UuiServiceResponse<DokumentRead>> => {
  return uuiService.execute<DokumentRead>({
    method: HttpMethod.Post,
    app: App.PZW,
    module: Services.DokumenteUiModule.module,
    service: Services.DokumenteUiModule.services.uploadFileByBase64,
    payload: dokumentWrite,
  });
};
