import { IcDeleteM, IcDocumentM, IcDownloadM } from '@finanzinformatik/mcd-module-icons';
import { Box, Card, Grid, IconButton, Stack, Typography } from '@mui/material';
import { DialogAction, DialogProvider, ThemeConstants } from '@personalsysteme/core';
import { useState } from 'react';
import { useTranslation } from 'react-i18next';

interface DokumentItemProps {
  fileName: string;
  downloadDokument: () => void;
  deleteDokument: () => void;
  readOnly: boolean;
}

export const DokumentItem = ({ fileName, downloadDokument, deleteDokument, readOnly }: DokumentItemProps) => {
  const { t } = useTranslation();
  const [isConfirmationDialogOpen, setConfirmationDialogOpen] = useState<boolean>(false);
  const handleDialogOpen = () => {
    setConfirmationDialogOpen(true);
  };
  const handleDialogClose = () => {
    setConfirmationDialogOpen(false);
  };
  const handleConfirmation = (confirmed: boolean) => {
    if (confirmed) {
      deleteDokument();
    }
    handleDialogClose();
  };
  const abbrechenButton: DialogAction = {
    label: t('Nein'),
    variant: ThemeConstants.BUTTON_VARIANT_OUTLINED,
    type: 'submit',
    onClick: () => {
      handleConfirmation(false);
    },
  };
  const uebernehmenButton: DialogAction = {
    label: t('Ja'),
    variant: ThemeConstants.BUTTON_VARIANT_CONTAINED,
    type: 'submit',
    onClick: () => {
      handleConfirmation(true);
    },
  };

  return (
    <>
      <Card sx={{ marginBottom: 2 }}>
        <Stack direction={'row'} alignItems={'center'} spacing={2} padding={2} margin={2}>
          <Box sx={{ display: 'flex', alignItems: 'center' }}>{<IcDocumentM fontSize={'medium'} />}</Box>

          <Stack sx={{ flexGrow: 1 }}>
            <Typography variant={ThemeConstants.TYPOGRAPHY_MULTILINE_01}>{fileName}</Typography>
          </Stack>

          <IconButton>
            <IcDownloadM onClick={downloadDokument} />
          </IconButton>

          {!readOnly && (
            <IconButton>
              <IcDeleteM onClick={handleDialogOpen} />
            </IconButton>
          )}
        </Stack>
      </Card>

      <DialogProvider
        isOpen={isConfirmationDialogOpen}
        onClose={handleDialogClose}
        title={t('Dokumente.Tabelle.DokumentLoeschenTitel')}
        width={ThemeConstants.WIDTH_SM}
        actions={[abbrechenButton, uebernehmenButton]}
      >
        <Grid container spacing={ThemeConstants.GRID_CONTAINER_SPACING}>
          <Grid size={12}>
            <Typography>{t('Dokumente.Tabelle.DokumentLoeschen')}</Typography>
          </Grid>
        </Grid>
      </DialogProvider>
    </>
  );
};

