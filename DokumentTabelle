import { useUuiService } from '@finanzinformatik/cpl-module-reactlib';
import { callUploadFileByBase64 } from '../../apl/pzw/dokumenteUiModule/dokumenteUiModuleApi';
import { DokumentRead } from '../../apl/pzw/dokumenteUiModule/DokumentRead';
import { DokumentWrite } from '../../apl/pzw/dokumenteUiModule/DokumentWrite';
import { DokumentConstants } from '../../constants/PzwConstants';
import { DokumentUploadZone } from './DokumentUploadZone';

interface DokumenteZuListeHochladenDialogProps {
  addDokumente: (dokument: DokumentRead) => void;
}

export const DokumentUpload = ({ addDokumente }: DokumenteZuListeHochladenDialogProps) => {
  const uuiService = useUuiService();
  const uploadFile = (base64Str: string, file: File): void => {
    const dokumentWrite: DokumentWrite = {
      dokumentName: file.name,
      base64: base64Str,
    };
    callUploadFileByBase64(uuiService, dokumentWrite).then((response) => {
      if (response.payload) {
        const dokument: DokumentRead = {
          dokumentName: file.name,
          undDownloadToken: response.payload.undDownloadToken,
        };
        addDokumente(dokument);
      }
    });
  };
  const onHandleSubmit = (dateien: File[]): void => {
    let index: number = 0;
    dateien.forEach((file: File) => {
      index = index + 1;
      const reader = new FileReader();
      reader.onload = () => {
        if (reader.result !== null && typeof reader.result === 'string') {
          uploadFile(reader.result, file);
        }
      };
      reader.readAsDataURL(file);
    });
  };

  return <DokumentUploadZone maxFiles={DokumentConstants.MAX_FILES} onSubmit={onHandleSubmit} />;
};
