package osplus.pzw.uimodule;

import org.springframework.http.HttpStatus;
import osplus.apl.core.api.AplLogging;
import osplus.apl.core.api.i18n.I18nService;
import osplus.apl.core.api.validation.AplValidated;
import osplus.apl.uui.api.MethodType;
import osplus.apl.uui.api.ServiceParam;
import osplus.apl.uui.api.ServiceResponse;
import osplus.apl.uui.api.ServiceReturnType;
import osplus.apl.uui.api.UiModule;
import osplus.apl.uui.api.UiService;
import osplus.apl.uui.api.UiServiceReturnType;
import osplus.apl.uui.api.message.MessageService;
import osplus.fi.core.uui.api.message.MessageType;
import osplus.psk.core.apl.AbstractUiModule;
import osplus.psk.core.apl.exception.UiServiceException;
import osplus.psk.core.apl.messages.MessageCallType;
import osplus.psk.core.apl.messages.MessageCode;
import osplus.psk.core.apl.messages.MessageMetadata;
import osplus.psk.core.apl.messages.MessageScope;
import osplus.psk.core.apl.services.DokumentService;
import osplus.psk.core.model.dokument.DokumentRead;
import osplus.psk.core.model.dokument.DokumentWrite;
import osplus.pzw.constants.DokumenteUiModuleConstants;


/**
 * UiModule für Service-Funktionen für Dokumente.
 *
 * @see UiModule
 */
@UiModule(DokumenteUiModuleConstants.NAME)
@AplValidated
public class DokumenteUiModule extends AbstractUiModule {

    private final transient DokumentService dokumentService;

    public DokumenteUiModule(final MessageService messageService,
                             final I18nService i18nService,
                             final DokumentService dokumentService) {
        super(messageService, i18nService);
        this.dokumentService = dokumentService;
    }

    /**
     * Der @UiService refreshDownloadLink erneuert den Download-Link zum übergebenen UND-Token.
     *
     * @param dokumentWrite DokumentWrite
     * @return ServiceResponse(DokumentRead)
     */
    @UiService(value = DokumenteUiModuleConstants.UI_SERVICE_UPLOAD_FILE_BY_BASE64, method = MethodType.POST, requiresAuthentication = true, internalOnly = true)
    @UiServiceReturnType({
            @ServiceReturnType(statusCode = 200, value = DokumentRead.class),
            @ServiceReturnType(statusCode = 400)
    })
    @AplLogging(logExecutionTime = true, includeParameters = true, logTrace = true)
    public ServiceResponse<DokumentRead> uploadFileByBase64(
            @AplValidated DokumentWrite dokumentWrite
    ) {
        try {
            DokumentRead result = dokumentService.uploadFileByBase64(dokumentWrite);
            messageService.addMessage(MessageType.SUCCESS, MessageCode.OK,
                    i18nService.getMessage("Dokument.Upload.Create.HttpStatus.200"),
                    MessageMetadata.instance(MessageCallType.CREATE, MessageScope.APL));
            return new ServiceResponse<>(HttpStatus.OK.value(), result);
        } catch (UiServiceException e) {
            handleException(e);
            return new ServiceResponse<>(Integer.parseInt(e.getMessageCode()));
        }
    }

    /**
     * Der @UiService downloadFileByDownloadToken lädt den Download-Link zum übergebenen UND-Download-Token.
     *
     * @param downloadToken DownloadToken
     * @return ServiceResponse(String)
     */
    @UiService(value = DokumenteUiModuleConstants.UI_SERVICE_DOWNLOAD_FILE_BY_DOWNLOADTOKEN, method = MethodType.GET, requiresAuthentication = true, internalOnly = true)
    @UiServiceReturnType({
            @ServiceReturnType(statusCode = 200, value = DokumentRead.class),
            @ServiceReturnType(statusCode = 400)
    })
    @AplLogging(logExecutionTime = true, includeParameters = true, logTrace = true)
    public ServiceResponse<String> downloadFileByDownloadToken(
            @ServiceParam(value = DokumenteUiModuleConstants.PARAM_DOWNLOAD_TOKEN) String downloadToken
            ) {
        try {
            String result = dokumentService.getUndDownloadUrl(downloadToken);
            messageService.addMessage(MessageType.SUCCESS, MessageCode.OK,
                    i18nService.getMessage("Dokument.Download.Get.HttpStatus.200"),
                    MessageMetadata.instance(MessageCallType.READ, MessageScope.APL));
            return new ServiceResponse<>(HttpStatus.OK.value(), result);
        } catch (UiServiceException e) {
            handleException(e);
            return new ServiceResponse<>(Integer.parseInt(e.getMessageCode()));
        }
    }
}
