import { Stack, Typography } from '@mui/material';
import { ThemeConstants } from '@personalsysteme/core';
import { Dispatch, SetStateAction } from 'react';
import { useTranslation } from 'react-i18next';
import { DokumentRead } from '../../apl/pzw/dokumenteUiModule/DokumentRead';
import { useCreateDownloadLink } from '../../tanstack/dokumente/useCreateDownloadLink';
import { downloadFile } from '../../utils/FileUtils';
import { DokumentItem } from './DokumentItem';
import { DokumentUpload } from './DokumentUpload';

interface DokumentenTableProps {
  dokumente: DokumentRead[];
  readOnly: boolean;
  setDokumente?: Dispatch<SetStateAction<DokumentRead[]>>;
}

export const DokumentTabelle = ({ dokumente, setDokumente, readOnly }: DokumentenTableProps) => {
  const { t } = useTranslation();
  const { mutateAsync: createDownloadLink } = useCreateDownloadLink();

  const addDokumente = (newDokument: DokumentRead) => {
    if (!readOnly && setDokumente) {
      setDokumente((prev) => [...prev, newDokument]);
    }
  };

  const deleteDokument = (dokument: DokumentRead) => {
    if (!readOnly && setDokumente) {
      const dokumenteArray = dokumente.filter((x) => x.undDownloadToken !== dokument.undDownloadToken);
      setDokumente(dokumenteArray);
    }
  };

  const downloadDokument = (dokument: DokumentRead) => {
    createDownloadLink(dokument.undDownloadToken ?? '', {
      onSuccess: (dowloadUrl) => {
        if (dowloadUrl) {
          downloadFile(dowloadUrl);
        }
      },
    });
  };

  return (
    <>
      <Typography variant={ThemeConstants.TYPOGRAPHY_HEADLINE_03}>{t('Dokumente.Title')}</Typography>
      <Stack direction="column" width={ThemeConstants.WIDTH_100_PERCENT} gap={2}>
        {!readOnly && <DokumentUpload addDokumente={addDokumente} />}
        <Stack>
          {dokumente.map((dokument, index) => (
            <DokumentItem
              key={index}
              fileName={dokument.dokumentName ?? ''}
              downloadDokument={() => downloadDokument(dokument)}
              deleteDokument={() => deleteDokument(dokument)}
              readOnly={readOnly}
            />
          ))}
        </Stack>
      </Stack>
    </>
  );
};
