import { UuiServiceMessageType } from '@finanzinformatik/cpl-module-clientlib';
import { IcUploadM } from '@finanzinformatik/mcd-module-icons';
import { Card, CardContent, Typography, useTheme } from '@mui/material';
import { addNotification, ThemeConstants } from '@personalsysteme/core';
import { useCallback } from 'react';
import { ErrorCode, FileRejection, useDropzone } from 'react-dropzone';
import { useTranslation } from 'react-i18next';
import { DokumentConstants } from '../../constants/PzwConstants';

interface DokumenteHochladenDialogProps {
  maxFiles?: number;
  onSubmit: (dateien: File[]) => void;
}

export const DokumentUploadZone = ({ maxFiles, onSubmit }: DokumenteHochladenDialogProps) => {
  const { t } = useTranslation();
  const theme = useTheme();
  const onDropAccepted = useCallback((files: File[]) => {
    onSubmit(files);
  }, []);
  const onDropRejected = useCallback((fileRejections: FileRejection[]) => {
    fileRejections.forEach((fileRejection) => {
      fileRejection.errors.forEach((fileError) => {
        if (ErrorCode.FileInvalidType === fileError.code) {
          addNotification(
            t('Warnung'),
            t('Dokumente.Upload.InvalidFile', { filename: fileRejection.file.name }),
            UuiServiceMessageType.Warn
          );
        } else if (ErrorCode.FileTooLarge === fileError.code) {
          addNotification(
            t('Warnung'),
            t('Dokumente.Upload.FileToLarge', { filename: fileRejection.file.name }),
            UuiServiceMessageType.Warn
          );
        } else if (ErrorCode.TooManyFiles === fileError.code) {
          addNotification(
            t('Warnung'),
            t('Dokumente.Upload.MaxFiles', { filename: fileRejection.file.name }),
            UuiServiceMessageType.Warn
          );
          return false;
        } else {
          addNotification(
            t('Warnung'),
            t('Dokumente.Upload.Fehler', { filename: fileRejection.file.name }),
            UuiServiceMessageType.Warn
          );
        }
      });
    });
  }, []);
  const { getRootProps, getInputProps } = useDropzone({
    accept: {
      'image/jpeg': [],
      'application/pdf': [],
    },
    maxFiles: maxFiles,
    maxSize: DokumentConstants.MAX_FILE_SIZE,
    onDropAccepted: onDropAccepted,
    onDropRejected: onDropRejected,
  });

  return (
    <>
      <Card>
        <CardContent sx={{ padding: { xs: theme.sizes.small05, md: theme.sizes.small20 } }}>
          <div
            {...getRootProps()}
            style={{
              display: 'flex',
              flexDirection: 'column',
              alignItems: 'center',
              gap: ThemeConstants.CARD_CONTENT_GAP,
            }}
          >
            <input {...getInputProps()} />
            <IcUploadM
              style={{
                height: '40px',
                width: '40px',
              }}
            />
            <Typography style={{ cursor: 'pointer' }}>{t('Dokumente.Upload.DateienAuswaehlen')}</Typography>
            <Typography>{t('Dokumente.Upload.Hinweis')}</Typography>
          </div>
        </CardContent>
      </Card>
    </>
  );
};
