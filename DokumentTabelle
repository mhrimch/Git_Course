export const DokumentItem = ({ fileName, downloadDokument, deleteDokument, showDownload, showDelete }: DokumentItemProps) => {
  const { t } = useTranslation();
  const [isConfirmationDialogOpen, setConfirmationDialogOpen] = useState<boolean>(false);

  const handleDialogOpen = () => setConfirmationDialogOpen(true);
