/**
 * Die Funktion callReadBenutzerStatus liest die Benutzer-Buchung-Status-Informationen zum angemeldeten Benutzer.
 * @param uuiService
 */
export const callReadBenutzerStatus = async (
  uuiService: UuiServiceClient
): Promise<UuiServiceResponse<BenutzerStatusRead>> => {
  return uuiService.execute<BenutzerStatusRead>({
    method: HttpMethod.Get,
    app: App.PZW,
    module: Services.BenutzerUiModule.module,
    service: Services.BenutzerUiModule.services.readBenutzerStatus,
  });
};
