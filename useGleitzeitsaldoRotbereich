import { useUuiService, UuiServiceClientDef, UuiServiceResponse } from '@finanzinformatik/cpl-module-reactlib';
import {
  ExtendedUuiServiceMessage,
  NotificationStoreActions,
  useNotificationStoreActions,
} from '@personalsysteme/core';
import { queryOptions, useQuery, UseQueryResult } from '@tanstack/react-query';
import { BenutzerSaldoRead } from '../../apl/pzw/benutzerUiModule/BenutzerSaldoRead';
import { callReadBenutzerSaldo } from '../../apl/pzw/benutzerUiModule/BenutzerUiModule.api';
import { TanstackConstants } from '../../constants/TanstackConstants';
import { isRollout } from '../../utils/rolloutUtils';
import { BenutzerKeys } from './Benutzer.keys';

export function readStatusOptions(
  uuiService: Readonly<UuiServiceClientDef>,
  notificationStoreActions: NotificationStoreActions
) {
  return queryOptions({
    queryKey: BenutzerKeys.saldo,
    queryFn: async (): Promise<BenutzerSaldoRead & { isRollout: boolean }> =>
      callReadBenutzerSaldo(uuiService).then((response: UuiServiceResponse<BenutzerSaldoRead>) => {
        notificationStoreActions.handleMessages(response.messages as ExtendedUuiServiceMessage[], true);
        return {
          ...(response.payload as BenutzerSaldoRead),
          //TODO Entfernen wenn Rollout abgeschlossen ist
          isRollout: isRollout(response.messages),
        };
      }),
    staleTime: TanstackConstants.LONG_STALE_TIME,
    retry: false,
  });
}

export function useReadBenutzerSaldo(): UseQueryResult<(BenutzerSaldoRead & { isRollout: boolean }) | undefined> {
  const uuiService = useUuiService();
  const notificationStoreActions = useNotificationStoreActions();
  return useQuery(readStatusOptions(uuiService, notificationStoreActions));
}

