        } catch (OspeException exception) {
            throw new UiServiceException(MessageType.ERROR, MessageCode.ERROR,
                    "Benutzer.Urlaub.Read.HttpStatus.502",
                    MessageMetadata.instance(MessageCallType.READ, MessageScope.APL));
