export const callReadBenutzerUrlaub = async (
  uuiService: UuiServiceClient
): Promise<UuiServiceResponse<BenutzerUrlaubRead>> => {
  return uuiService.execute<BenutzerUrlaubRead>({
    method: HttpMethod.Get,
    app: App.PZW,
    module: Services.BenutzerUiModule.module,
    service: Services.BenutzerUiModule.services.readBenutzerUrlaub,
  });
};

