export function useUpdateKonfArbeitsorte() {
  const uuiService = useUuiService();
  return useMutation({
    mutationFn: async (konfEinstellungWrite: KonfArbeitsorteWrite) =>
      callUpdateKonfArbeitsorte(uuiService, konfEinstellungWrite).then((response: UuiServiceResponse<void>) => {
        return response.success;
      }),
  });
}
