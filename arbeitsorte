export function readKonfigOptions(uuiService: Readonly<UuiServiceClientDef>) {
  return queryOptions({
    queryKey: KonfigKeys.konfigArbeitsorte,
    queryFn: async (): Promise<(KonfArbeitsorteRead & { isRollout: boolean }) | undefined> =>
      callReadKonfArbeitsorte(uuiService).then((response: UuiServiceResponse<KonfArbeitsorteRead>) => {
        //TODO Entfernen wenn Rollout abgeschlossen ist
        return {
          ...(response.payload as KonfArbeitsorteRead),
          isRollout: isRollout(response.messages),
        };
      }),
  });
}

export function useReadKonfArbeitsorte(): UseQueryResult<(KonfArbeitsorteRead & { isRollout: boolean }) | undefined> {
  const uuiService = useUuiService();
  return useQuery(readKonfigOptions(uuiService));
}


