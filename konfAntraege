export const KonfAntraege = () => {
  const { t } = useTranslation();
  const workflowService = useWorkflowService();
  const [kategorieAuswahl, setKategorieAuswahl] = useState<KonfAntragskategorieRead | null>(null);
  const { data: konfAntraege, isFetching: isKonfAntraegeLoading } = useReadKonfAntraege();
  console.log('konfAntraege', konfAntraege);
  const handleClickAntragKategorie = (kategorie: KonfAntragskategorieRead) => {
    setKategorieAuswahl(kategorie);
  };
  const handleClickZurueckZuKonfiguration = () => {
    navigateToPskKonfiguration(workflowService);
  };
  const handleClickZurueckZuAntraege = () => {
    setKategorieAuswahl(null);
  };
  const categoryColors = useMcdPalette().ColorCategoryTokens;
  if (!konfAntraege?.isRollout) {
    return <></>;
  }
  if (kategorieAuswahl) {
    return (
      <KonfAntragsgruppen
        antragskategorie={kategorieAuswahl}
        versionsnummer={konfAntraege.versionsnummer}
        buchungskreis={konfAntraege.buchungskreis}
        handleClickZurueckZuAntraege={handleClickZurueckZuAntraege}
      />
    );
  }
  return (
    <Stack spacing={ThemeConstants.STACK_SPACING} width={ThemeConstants.WIDTH_100_PERCENT}>
      <Box>
        <Button size="small" onClick={handleClickZurueckZuKonfiguration}>
          {t('ZurueckZurKonfiguration')}
        </Button>
      </Box>
      <Grid container spacing={ThemeConstants.GRID_CONTAINER_SPACING} justifyContent={'center'}>
        <Grid size={{ xs: 12 }}>
          <Typography variant={ThemeConstants.TYPOGRAPHY_HEADLINE_02} component="div">
            {t('Antraege')}
          </Typography>
        </Grid>
        {!isKonfAntraegeLoading && (
          <Grid size={{ xs: 12 }} container spacing={ThemeConstants.GRID_CONTAINER_SPACING}>
            {konfAntraege.antragskategorien?.map((kategorie) => {
              const iconConfig = getAntragskategorieIcon(kategorie.id);
              return (
                <Grid key={kategorie.id} size={{ xs: 12 }}>
                  <KonfMenuCard
                    ueberschrift={kategorie.bezeichnung}
                    beschreibung={kategorie.beschreibung}
                    CardIcon={iconConfig.icon}
                    iconColor={categoryColors[iconConfig.color]}
                    iconBgColor={categoryColors[iconConfig.bgColor]}
                    onClick={() => handleClickAntragKategorie(kategorie)}
                  />
                </Grid>
              );
            })}
          </Grid>
        )}
      </Grid>
    </Stack>
  );
};
