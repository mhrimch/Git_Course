export const KonfAntragsgruppen = ({
  antragskategorie,
  versionsnummer,
  buchungskreis,
  handleClickZurueckZuAntraege,
}: KonfAntragsgruppenProps) => {
  const categoryColors = useMcdPalette().ColorCategoryTokens;
  const [gruppenAuswahl, setGruppenAuswahl] = useState<KonfAntragsgruppeRead | null>(null);
  const { t } = useTranslation();
  const handleClickAntragsgruppe = (antragsgruppe: KonfAntragsgruppeRead) => {
    setGruppenAuswahl(antragsgruppe);
  };
  const handleClickZurueckZuAntragsgruppen = () => {
    setGruppenAuswahl(null);
  };
  const iconConfig = getAntragskategorieIcon(antragskategorie.id);
  if (gruppenAuswahl) {
    return (
      <KonfAntragTable
        antragsgruppe={gruppenAuswahl}
        versionsnummer={versionsnummer}
        buchungskreis={buchungskreis}
        handleClickZurueckZuAntragsgruppen={handleClickZurueckZuAntragsgruppen}
      />
    );
  }
  return (
    <Stack spacing={ThemeConstants.STACK_SPACING} width={ThemeConstants.WIDTH_100_PERCENT}>
      <Box>
        <Button size="small" onClick={handleClickZurueckZuAntraege}>
          {t('ZurueckZuAntraege')}
        </Button>
      </Box>
      <Grid container spacing={ThemeConstants.GRID_CONTAINER_SPACING} justifyContent={'center'}>
        <Grid size={{ xs: 12 }}>
          <Typography variant={ThemeConstants.TYPOGRAPHY_HEADLINE_02} component="div">
            {t('Antragsgruppen')}
          </Typography>
        </Grid>
        <Grid size={{ xs: 12 }} container spacing={ThemeConstants.GRID_CONTAINER_SPACING}>
          {antragskategorie.antragsgruppen.map((antragsgruppe) => {
            return (
              <Grid key={antragsgruppe.id} size={{ xs: 6 }}>
                <KonfMenuCard
                  ueberschrift={antragsgruppe.bezeichnung}
                  beschreibung={antragsgruppe.beschreibung}
                  CardIcon={iconConfig.icon}
                  iconColor={categoryColors[iconConfig.color]}
                  iconBgColor={categoryColors[iconConfig.bgColor]}
                  onClick={() => handleClickAntragsgruppe(antragsgruppe)}
                />
              </Grid>
            );
          })}
        </Grid>
      </Grid>
    </Stack>
  );
};
