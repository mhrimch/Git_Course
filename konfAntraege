export const KonfAntragCollapsible = ({
  antrag,
  antragsgruppe,
  versionsnummer,
  buchungskreis,
}: KonfAntragsgruppenCollapsibleProps) => {
  const theme = useTheme();
  const matches = useMediaQuery(theme.breakpoints.up('sm'));
  const [open, setOpen] = useState(false);
  const [antragAktiv, setAntragAktiv] = useState(antrag.isAktiv);
  const { t } = useTranslation();
  const notificationStoreActions = useNotificationStoreActions();
  const { data: isAntragInPersonalservicesAktiv, isLoading: isAntragPSLoading } = isPersonalserviceAktiv(
    AntragsschluesselPersonalservices[antrag.schluessel],
    antrag.isUrl
  );
  const isAntragAktiv =
    antrag.isUrl && !isAntragPSLoading && isAntragInPersonalservicesAktiv === false ? false : antragAktiv;
  const handleClickAktivitaetAendern = () => {
    if (antrag.isUrl && !isAntragPSLoading && isAntragInPersonalservicesAktiv === false) {
      notificationStoreActions.addInfoNotification(t('KonfigurationPersonalservicesMeldung'));
      return;
    }
    setAntragAktiv(!antragAktiv);
  };
  if (matches) {
    return (
      <>
        <TableRow>
          <TableCell component="th" scope="row">
            <Typography variant={ThemeConstants.TYPOGRAPHY_INPUT_01} noWrap={true}>
              {antrag.bezeichnung}
            </Typography>
          </TableCell>
          <TableCell width={'15%'}>
            {!isAntragPSLoading && (
              <Stack
                direction={'row'}
                alignItems={'center'}
                spacing={2}
                justifyContent={ThemeConstants.CONTENT_ALIGN_SPACE_BETWEEN}
              >
                <Stack
                  direction={'row'}
                  alignItems={'center'}
                  justifyContent={ThemeConstants.CONTENT_ALIGN_SPACE_BETWEEN}
                >
                  <Switch checked={isAntragAktiv} value={antragAktiv} onClick={handleClickAktivitaetAendern}></Switch>
                  <Typography variant={ThemeConstants.TYPOGRAPHY_LABEL_03} noWrap={true}>
                    {isAntragAktiv ? t('aktiviert') : t('deaktiviert')}
                  </Typography>
                </Stack>
                <IconButton
                  aria-label="expand row"
                  onClick={() => {
                    setOpen(!open);
                  }}
                >
                  {open ? <IcUpS /> : <IcDownS />}
                </IconButton>
              </Stack>
            )}
          </TableCell>
        </TableRow>
        <TableRow>
          <TableCell style={{ paddingBottom: 0, paddingTop: 0 }} colSpan={2}>
            <Collapse in={open} timeout="auto" unmountOnExit>
              <KonfAntragEigenschaftenPanel
                antragsgruppe={antragsgruppe}
                antrag={antrag}
                antragAktiv={antragAktiv}
                buchungskreis={buchungskreis}
                versionsnummer={versionsnummer}
                isAntragInPersonalservicesAktiv={isAntragInPersonalservicesAktiv}
              />
            </Collapse>
          </TableCell>
        </TableRow>
      </>
    );
  }
  return (
    <>
      <TableRow>
        <TableCell component="th" scope="row">
          <Grid container spacing={10}>
            <Grid size={{ xs: 12, lg: 8 }}>
              <Typography variant={ThemeConstants.TYPOGRAPHY_INPUT_01}>{antragsgruppe.bezeichnung}</Typography>
            </Grid>
            {!isAntragPSLoading && (
              <Grid size={{ xs: 10, lg: 8 }}>
                <Stack direction={'row'} alignItems={'center'}>
                  <Switch checked={isAntragAktiv} value={antragAktiv} onClick={handleClickAktivitaetAendern}></Switch>
                  <Typography>{antragAktiv ? t('aktiviert') : t('deaktiviert')}</Typography>
                </Stack>
              </Grid>
            )}
            <Grid size={{ xs: 2, lg: 12 }}>
              <IconButton
                aria-label="expand row"
                onClick={() => {
                  if (antragAktiv || open) {
                    setOpen(!open);
                  }
                }}
              >
                {open ? <IcUpS /> : <IcDownS />}
              </IconButton>
            </Grid>
          </Grid>
        </TableCell>
      </TableRow>
      <TableRow>
        <TableCell style={{ paddingBottom: 0, paddingTop: 0 }} colSpan={4}>
          <Collapse in={open} timeout="auto" unmountOnExit>
            <KonfAntragEigenschaftenPanel
              antragsgruppe={antragsgruppe}
              antrag={antrag}
              antragAktiv={antragAktiv}
              buchungskreis={buchungskreis}
              versionsnummer={versionsnummer}
            />
          </Collapse>
        </TableCell>
      </TableRow>
    </>
  );
};
