    public ServiceResponse<AnzahlMitarbeiterRotbereich> readAnzahlMitarbeiterRotbereich() throws UiServiceException, OspeException {
        System.out.println("readAnzahlMitarbeiterRotbereich --> called");
        String fkPersSchluessel = userService.getPersonalnummer();
        System.out.println("userService.getPersonalnummer() --> " + fkPersSchluessel);
        List<MitarbeiterRead> listeMitarbeiterFuehrungskraft = this.mitarbeiterService.readMitarbeiterList(fkPersSchluessel);
        listeMitarbeiterFuehrungskraft.forEach(ma -> System.out.println("mitarbeiterservice.readMitarbeiterList() --> " + ma.personalnummer()));
        LiesPmgtPzwSchwellenwerteUeberFuehrungskraftEingabe eingabe = new LiesPmgtPzwSchwellenwerteUeberFuehrungskraftEingabe();
        eingabe.setPctlPersSchl(fkPersSchluessel);
        eingabe.setPzwKtag(new Date());
        eingabe.setFrkrPctlPersSchl(fkPersSchluessel);
        eingabe.setMaPctlPersSchl(listeMitarbeiterFuehrungskraft.get(0).personalnummer());
        Optional<PmgtPzwSchwellenwerteLesAusgabe> ausgabe = this.schwellenwerteLesRepository.liesPmgtPzwSchwellenwerteUeberFuehrungskraft(eingabe);
        System.out.println("ausgabe.get() --> " + ausgabe.get().getPmgtPzwSchwellenwerteGltztSaldo().getPmgtPzwSchwellenwertGltztSaldoMa().get(0).getPzwGlztSdoSwlw() + "  " + ausgabe.get().getPmgtPzwSchwellenwerteRestUrlaub().getPmgtPzwSchwellenwertRestUrlaubMa().get(0).getPzwRestUrlbSwlw());
        return new ServiceResponse<>(HttpStatus.OK.value(), new AnzahlMitarbeiterRotbereich(10L, 20L));
    }
	
